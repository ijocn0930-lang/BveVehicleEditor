    <sys:String x:Key="Pf.057">Location (top left of the digits)</sys:String>
    <!-- 位置（回転中心） -->
    <sys:String x:Key="Pf.058">Location (rotation center)</sys:String>
    <!-- {0}（{1}）：このバージョンでは「#」から後ろはコメントになるので、色が読まれません。「#」を付けずに 00FFFF のように書いてください。 -->
    <sys:String x:Key="Pf.059">{0} ({1}): in this version everything after "#" is a comment, so the color is not read. Write it without "#", like 00FFFF.</sys:String>
    <!-- ヘッダーのバージョン（{0}）では、{1}（{2}）は使えません（BveTs Instrument Panel 2.01 の項目）。 -->
    <sys:String x:Key="Pf.060">With this header version ({0}), {1} ({2}) cannot be used (it is a BveTs Instrument Panel 2.01 item).</sys:String>
    <!-- {0}（{1}）は、このヘッダーのバージョン（{2}）では使えません。BVE で読まれないことがあります。 -->
    <sys:String x:Key="Pf.061">{0} ({1}) cannot be used with this header version ({2}). BVE may not read it.</sys:String>
    <!-- 昼間の画像 -->
    <sys:String x:Key="Pf.062">Daytime image</sys:String>
    <!-- 夜間の画像 -->
    <sys:String x:Key="Pf.063">Nighttime image</sys:String>
    <!-- {0}（{1}）「{2}」が見つかりません（パネルファイルからの相対パスで探しました）。 -->
    <sys:String x:Key="Pf.064">{0} ({1}) "{2}" was not found (searched as a relative path from the panel file).</sys:String>
    <!-- {0}「{1}」の大きさ（{2}×{3}）は 2 のべき乗（64・128・256 …）ではありません。DirectX の仕様で、画像が間延び・縮んだり崩れたりすることがあります。 -->
    <sys:String x:Key="Pf.065">The size of {0} "{1}" ({2}×{3}) is not a power of two (64, 128, 256 …). Because of DirectX, the image may be stretched, shrunk or broken.</sys:String>
    <!-- （未記入） -->
    <sys:String x:Key="Pf.066">(empty)</sys:String>
    <!-- （既定: {0}） -->
    <sys:String x:Key="Pf.067">(default: {0})</sys:String>
    <!-- {0}（{1}）「{2}」は数字にしてください。 -->
    <sys:String x:Key="Pf.068">{0} ({1}) "{2}" must be a number.</sys:String>
    <!-- {0}（{1}）「{2}」は「x, y」の 2 つの数字にしてください。 -->
    <sys:String x:Key="Pf.069">{0} ({1}) "{2}" must be two numbers "x, y".</sys:String>
    <!-- {0}（{1}）「{2}」は 6 桁の 16 進数（例：FF0000）にしてください。 -->
    <sys:String x:Key="Pf.070">{0} ({1}) "{2}" must be a 6-digit hexadecimal number (e.g. FF0000).</sys:String>
    <!-- {0}（{1}）「{2}」は 0 ～ 255 の整数にしてください。 -->
    <sys:String x:Key="Pf.071">{0} ({1}) "{2}" must be a whole number from 0 to 255.</sys:String>
    <!-- 「;」と「#」 -->
    <sys:String x:Key="Pf.072">";" and "#"</sys:String>
    <!-- {0}はコメントの始まりなので、値には使えません。 -->
    <sys:String x:Key="Pf.073">{0} start a comment, so they cannot be used in values.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Pf.074">Confirm</sys:String>
    <!-- セクション（[This] や [Needle] など）が1つも書かれていません。 -->
    <sys:String x:Key="Pf.075">No section (such as [This] or [Needle]) is written.</sys:String>
    <!-- 古い形式（Version 1.0）のパネルです。この形式では「#」はコメントではなく色（#00ffff など）として読みます。 -->
    <sys:String x:Key="Pf.076">This is an old-format (Version 1.0) panel. In this format "#" is not a comment but is read as a color (such as #00ffff).</sys:String>
    <!-- ⚠ [This] がありません。BVE で運転台が丸ごと見えなくなります。「セクションを足す ▼」で [This] を足してください。 -->
    <sys:String x:Key="Pf.077">⚠ There is no [This]. The whole cab will not be visible in BVE. Add [This] with "Add section ▼".</sys:String>
    <!-- （このファイルは Shift_JIS なので、文字コードの指定 :shift_jis も付けます） -->
    <sys:String x:Key="Pf.078">(This file is Shift_JIS, so the encoding :shift_jis is also added.)</sys:String>
    <!-- 古い形式（Version 1.0）のパネルを、BveTs Instrument Panel 2.01 の形に書き直します。   -->
    <sys:String x:Key="Pf.079">The old-format (Version 1.0) panel will be converted to the BveTs Instrument Panel 2.01 format.

</sys:String>
    <!-- ・1 行目のヘッダーを「{0}」にします{1}  -->
    <sys:String x:Key="Pf.080">• Change the header on line 1 to "{0}"{1}
</sys:String>
    <!-- ・色（Color・TransparentColor）の前の「#」を外します（{0} か所）   -->
    <sys:String x:Key="Pf.081">• Remove the "#" before colors (Color, TransparentColor) ({0} place(s))

</sys:String>
    <!-- テキストをクリックして Ctrl+Z で戻せます。保存は「すべて保存」のときです。  書き直しますか？ -->
    <sys:String x:Key="Pf.082">Click the text and press Ctrl+Z to undo. It is saved when you use "Save All".

Convert it?</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Pf.083">Confirm</sys:String>
    <!-- 次の行には、色のほかに「#」があります（{0}）。 2.01 では「#」から後ろはコメントになるので、必要なら下のテキストで直してください。 -->
    <sys:String x:Key="Pf.084">The following lines contain "#" other than in colors ({0}).
In 2.01 everything after "#" is a comment, so fix them in the text below if needed.</sys:String>
    <!-- お知らせ -->
    <sys:String x:Key="Pf.085">Information</sys:String>
    <!-- [{0}] {1}つ目 -->
    <sys:String x:Key="Pf.086">[{0}] #{1}</sys:String>
