    <!-- （一覧にない状態量です） -->
    <sys:String x:Key="Pf.039">(not in the list of values)</sys:String>
    <!--   [This] を消すと、BVE で運転台が丸ごと見えなくなります。 -->
    <sys:String x:Key="Pf.040">

If you delete [This], the whole cab will not be visible in BVE.</sys:String>
    <!-- {0} のセクションと、その中の値（{1} 件）を下のテキストから消します（テキストをクリックして Ctrl+Z で戻せます）。{2}  消しますか？ -->
    <sys:String x:Key="Pf.041">The {0} section and its values ({1}) will be deleted from the text below (click the text and press Ctrl+Z to undo).{2}

Delete it?</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Pf.042">Confirm</sys:String>
    <!-- 可動範囲の制限 -->
    <sys:String x:Key="Pf.043">Stop pin</sys:String>
    <!-- 可動範囲の制限 -->
    <sys:String x:Key="Pf.044">Stop pin</sys:String>
    <!-- 最小値～最大値の間で止める（既定: {0}） -->
    <sys:String x:Key="Pf.045">Stop between Minimum and Maximum (default: {0})</sys:String>
    <!-- 最小値～最大値の間で止める -->
    <sys:String x:Key="Pf.046">Stop between Minimum and Maximum</sys:String>
    <!-- 可動範囲の制限（StopPin）「{0}」は True か False にしてください。 -->
    <sys:String x:Key="Pf.047">Stop pin (StopPin) "{0}" must be True or False.</sys:String>
    <!-- 面の色 -->
    <sys:String x:Key="Pf.048">Face color</sys:String>
    <!-- LED 消灯の色 -->
    <sys:String x:Key="Pf.049">Color of unlit LEDs</sys:String>
    <!-- 針の半径 -->
    <sys:String x:Key="Pf.050">Needle radius</sys:String>
    <!-- ゲージの半径 -->
    <sys:String x:Key="Pf.051">Gauge radius</sys:String>
