<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- ResistanceWindow.xaml.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 抵抗制御で作る - 力行・{0} -->
    <sys:String x:Key="Rw.001">Create for Resistance Control - Power - {0}</sys:String>
    <!-- 開いている表：力行の{0}（列は進段ごと。どの表も M 車 1 両あたり） -->
    <sys:String x:Key="Rw.002">Open table: power {0} (columns are per step; all tables are per M car)</sys:String>
    <!-- 今の表（引張力と電流）に一番合うように、全界磁の点・界磁の割合・飽和 s・中の抵抗 r・損失 L を選び直します -->
    <sys:String x:Key="Rw.003">Re-chooses the full-field point, field ratios, saturation s, internal resistance r and loss L to best match the current tables (force and current)</sys:String>
    <!-- 引張力と電流の両方の表が読めないので使えません（ノッチのファイルに引張力（空車）と電流（空車）の表を書いてください） -->
    <sys:String x:Key="Rw.004">Not available because the force and current tables cannot both be read (write the force (empty) and current (empty) tables in the notch file)</sys:String>
    <!-- 進段パラメーターがノッチのファイルに書かれていないか、見つからないので、段の数と限流値は仮の値です。 -->
    <sys:String x:Key="Rw.005">The step parameters are not written in the notch file or were not found, so the numbers of steps and the current limit are provisional.</sys:String>
    <!-- 進段パラメーターが見つからないので、段の数と限流値は仮の値です。 -->
    <sys:String x:Key="Rw.006">The step parameters were not found, so the numbers of steps and the current limit are provisional.</sys:String>
    <!-- 進段パラメーター（{0}）の見出し（S・P・WF）と限流値（空車）から読みました。ここで直しても、進段パラメーターは変わりません。 -->
    <sys:String x:Key="Rw.007">Read from the headers (S, P, WF) and the current limit (empty car) of the step parameters ({0}). Changing them here does not change the step parameters.</sys:String>
    <!-- 進段パラメーター（{0}）に段の見出し（S1・P1・WF1 など）がないので、直列・並列・弱め界磁の数は仮の値です。限流値（空車）は読みました。 -->
    <sys:String x:Key="Rw.008">The step parameters ({0}) have no step headers (such as S1, P1, WF1), so the numbers of series, parallel and field weakening steps are provisional. The current limit (empty car) was read.</sys:String>
    <!-- 進段パラメーターを読めなかったので、段の数と限流値は仮の値です。（{0}） -->
    <sys:String x:Key="Rw.009">The step parameters could not be read, so the numbers of steps and the current limit are provisional. ({0})</sys:String>
    <!-- ・空車と同じ値 -->
    <sys:String x:Key="Rw.010">, same values as empty</sys:String>
    <!-- {0}（開いている表{1}） -->
    <sys:String x:Key="Rw.011">{0} (open table{1})</sys:String>
    <!-- {0}（ファイルなし） -->
    <sys:String x:Key="Rw.012">{0} (no file)</sys:String>
    <!-- 画面の表を置き換えます（保存するまでファイルは変わりません） -->
    <sys:String x:Key="Rw.013">Replaces the table in the window (the file does not change until you save)</sys:String>
    <!-- このファイルに直接書きます：{0} -->
    <sys:String x:Key="Rw.014">Writes directly to this file: {0}</sys:String>
    <!-- ノッチのファイルに書かれていないか、ファイルが見つかりません（ノッチのタブの「参照」で選んでください） -->
    <sys:String x:Key="Rw.015">Not written in the notch file, or the file was not found (choose it with "Browse" on the Notch tab)</sys:String>
    <!-- 引張力 -->
    <sys:String x:Key="Rw.016">Force</sys:String>
    <!-- 電流 -->
    <sys:String x:Key="Rw.017">Current</sys:String>
    <!-- 「作る表」を 1 つ以上チェックしてください。 -->
    <sys:String x:Key="Rw.018">Check at least one table in "Tables to create".</sys:String>
    <!-- {0}が数字ではありません（「{1}」）。 -->
    <sys:String x:Key="Rw.019">{0} is not a number ("{1}").</sys:String>
    <!-- {0}が整数ではありません（「{1}」）。 -->
    <sys:String x:Key="Rw.020">{0} is not a whole number ("{1}").</sys:String>
    <!-- 起動の段の数 -->
    <sys:String x:Key="Rw.021">Starting steps</sys:String>
    <!-- 直列の段の数 -->
    <sys:String x:Key="Rw.022">Series steps</sys:String>
    <!-- 並列の段の数 -->
    <sys:String x:Key="Rw.023">Parallel steps</sys:String>
    <!-- 弱め界磁の段の数 -->
    <sys:String x:Key="Rw.024">Field weakening steps</sys:String>
    <!-- 限流値 -->
    <sys:String x:Key="Rw.025">Current limit</sys:String>
    <!-- 弱め界磁の段の限流値 -->
    <sys:String x:Key="Rw.026">Field weakening current limit</sys:String>
    <!-- 全界磁の速度 -->
    <sys:String x:Key="Rw.027">Full-field speed</sys:String>
    <!-- 全界磁の力 -->
    <sys:String x:Key="Rw.028">Full-field force</sys:String>
    <!-- 飽和の強さ s -->
    <sys:String x:Key="Rw.029">Saturation s</sys:String>
    <!-- 電動機の中の抵抗 r -->
    <sys:String x:Key="Rw.030">Motor internal resistance r</sys:String>
    <!-- 損失 L -->
    <sys:String x:Key="Rw.031">Loss L</sys:String>
    <!-- 弱め界磁の飽和 s -->
    <sys:String x:Key="Rw.032">Field weakening saturation s</sys:String>
    <!-- 弱め界磁の中の抵抗 r -->
    <sys:String x:Key="Rw.033">Field weakening internal resistance r</sys:String>
    <!-- 弱め界磁の力の指数 q -->
    <sys:String x:Key="Rw.034">Field weakening force exponent q</sys:String>
    <!-- 最高速度 -->
    <sys:String x:Key="Rw.035">Maximum speed</sys:String>
    <!-- 速度の刻み -->
    <sys:String x:Key="Rw.036">Speed step</sys:String>
    <!-- 直列の電圧の割合 -->
    <sys:String x:Key="Rw.037">Series voltage ratio</sys:String>
    <!-- 界磁の割合に数字でない値があります（「{0}」）。 -->
    <sys:String x:Key="Rw.038">The field ratios contain a value that is not a number ("{0}").</sys:String>
    <!-- 界磁の割合の数（{0} 個）を、弱め界磁の段の数（{1}）と同じにしてください。 -->
    <sys:String x:Key="Rw.039">Make the number of field ratios ({0}) equal to the number of field weakening steps ({1}).</sys:String>
    <!-- 段ごとの切り替わる速度に数字でない値があります（「{0}」）。 -->
    <sys:String x:Key="Rw.040">The switching speeds contain a value that is not a number ("{0}").</sys:String>
    <!-- 行が多すぎます（最高速度 ÷ 刻みが 5000 未満になるようにしてください）。 -->
    <sys:String x:Key="Rw.041">Too many rows (make maximum speed ÷ step less than 5000).</sys:String>
    <!-- 作る段：全部で {0} 段（列） -->
    <sys:String x:Key="Rw.042">Steps to create: {0} steps (columns) in total</sys:String>
    <!-- {0}の段の跳ね上がりの倍率 {1:0.000} -->
    <sys:String x:Key="Rw.043">jump ratio of {0} steps {1:0.000}</sys:String>
    <!-- 並列の段の跳ね上がりの倍率 {0:0.000} -->
    <sys:String x:Key="Rw.044">jump ratio of parallel steps {0:0.000}</sys:String>
    <!-- 段ごとの切り替わる速度は入れた値。倍率は平均 -->
    <sys:String x:Key="Rw.045">switching speeds are the entered values; the ratio is the average</sys:String>
    <!-- 区間の中は同じ倍率 -->
    <sys:String x:Key="Rw.046">the same ratio within each range</sys:String>
    <!-- ・ -->
    <sys:String x:Key="Rw.047">,</sys:String>
    <!-- （{0}。跳ね上がりの倍率は、次の段に進んだときの電流が限流値の何倍になるか。サンプルでは 1.02～1.2）。 -->
    <sys:String x:Key="Rw.048"> ({0}. The jump ratio is how many times the current limit the current becomes when advancing to the next step; 1.02 to 1.2 in the samples).</sys:String>
    <!--  ⚠ 進段パラメーターは {0} 段（列）です。段の数を合わせないと、BVE で段と表の列がずれます（進段パラメーターは、表のウィンドウで列を足す・消すことができます）。 -->
    <sys:String x:Key="Rw.049">
⚠ The step parameters have {0} steps (columns). If the numbers do not match, the steps and the table columns will be out of step in BVE (you can add or delete columns of the step parameters in the table window).</sys:String>
    <!--  今の表は {0} 列です。表に入れると {1} 列になります。 -->
    <sys:String x:Key="Rw.050">
The current table has {0} columns. Putting it into the tables makes {1} columns.</sys:String>
    <!-- 全ノッチで走ったとき（式） -->
    <sys:String x:Key="Rw.051">Full notch (formula)</sys:String>
    <!-- 全ノッチで走ったとき（今の表） -->
    <sys:String x:Key="Rw.052">Full notch (current table)</sys:String>
    <!-- 並列 -->
    <sys:String x:Key="Rw.053">Parallel</sys:String>
    <!-- 弱め界磁 -->
    <sys:String x:Key="Rw.054">Field weakening</sys:String>
    <!-- {0}を 0 以上の整数にしてください。 -->
    <sys:String x:Key="Rw.055">{0} must be a whole number of 0 or more.</sys:String>
    <!-- {0}を 0 より大きい数字にしてください。 -->
    <sys:String x:Key="Rw.056">{0} must be a number greater than 0.</sys:String>
    <!-- 起動の段の数 -->
    <sys:String x:Key="Rw.057">Starting steps</sys:String>
    <!-- 直列の段の数 -->
    <sys:String x:Key="Rw.058">Series steps</sys:String>
    <!-- 並列の段の数 -->
    <sys:String x:Key="Rw.059">Parallel steps</sys:String>
    <!-- 弱め界磁の段の数 -->
    <sys:String x:Key="Rw.060">Field weakening steps</sys:String>
    <!-- 限流値 -->
    <sys:String x:Key="Rw.061">Current limit</sys:String>
    <!-- 弱め界磁の段の限流値 -->
    <sys:String x:Key="Rw.062">Field weakening current limit</sys:String>
    <!-- 最高速度 -->
    <sys:String x:Key="Rw.063">Maximum speed</sys:String>
    <!-- 速度の刻み -->
    <sys:String x:Key="Rw.064">Speed step</sys:String>
    <!-- 今の表に合わせるには、次の欄を直してください。  {0} -->
    <sys:String x:Key="Rw.065">To fit to the current table, please fix the following fields.

{0}</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Rw.066">Confirm</sys:String>
    <!-- 今の表を読み取れませんでした。  弱め界磁の段の数（{0}）と限流値（{1} A）が今の表に合っているか、全界磁の段（弱め界磁の 1 つ前の段）の電流が限流値まで下がっているかを確かめてください。 -->
    <sys:String x:Key="Rw.067">The current table could not be read.

Check that the number of field weakening steps ({0}) and the current limit ({1} A) match the current table, and that the current in the full-field step (the step before field weakening) falls to the current limit.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Rw.068">Confirm</sys:String>
    <!-- 今の表に合わせるには、次の欄を直してください。  {0} -->
    <sys:String x:Key="Rw.069">To fit to the current table, please fix the following fields.

{0}</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Rw.070">Confirm</sys:String>
    <!-- 到達時間が合うように、全界磁の力を今の表の値の {0:0.###} 倍にしました（式の段の作り方が今の表と少し違うため、そのままだと力が少し低めになります）。 -->
    <sys:String x:Key="Rw.071"> To match the times, the full-field force was set to {0:0.###} times the current table value (the formula builds the steps slightly differently from the current table, so the force would otherwise be slightly lower).</sys:String>
    <!-- 到達時間が合うように、全界磁の力を今の表の値の {0:0.###} 倍にしました（そのままだと、今の表より力が少し大きくなります）。 -->
    <sys:String x:Key="Rw.072"> To match the times, the full-field force was set to {0:0.###} times the current table value (otherwise the force would be slightly larger than the current table).</sys:String>
    <!-- 段ごとの切り替わる速度は、今の表の値を写しました（写さないより合ったため）。 -->
    <sys:String x:Key="Rw.073">The switching speeds were copied from the current table (it fit better than not copying).</sys:String>
    <!-- 段ごとの切り替わる速度は写さず、区間の中は同じ跳ね上がりの倍率にしました（写すより合ったため）。 -->
    <sys:String x:Key="Rw.074">The switching speeds were not copied; the same jump ratio is used within each range (it fit better than copying).</sys:String>
    <!-- 今の表に合わせました。全ノッチで走ったときのずれは、力が平均で約 {0:0.#}%・電流が約 {1:0.#}%、0 から 20 km/h ごとの到達時間がいちばん大きいところで約 {2:0.#}% です。{3}{4} -->
    <sys:String x:Key="Rw.075">Fitted to the current table. At full notch, the force differs by about {0:0.#}% on average and the current by about {1:0.#}%, and the time to reach each 20 km/h from 0 differs by about {2:0.#}% at most. {3}{4}</sys:String>
    <!-- ・{0}：開いている表を置き換えます（保存するまでファイルは変わりません） -->
    <sys:String x:Key="Rw.076">• {0}: replaces the open table (the file does not change until you save)</sys:String>
    <!-- ・{0}：{1} に直接書きます -->
    <sys:String x:Key="Rw.077">• {0}: written directly to {1}</sys:String>
    <!-- 次の表を作ります（どの表も {0} 行 × {1} 段（列）。満車の表は空車と同じ値です。先頭のコメントの行は残します）。  {2}  ファイルに直接書く表は、書く前の中身を同じフォルダーに「○○.日時.bak」で残します。 -->
    <sys:String x:Key="Rw.078">The following tables will be created (each table has {0} rows × {1} steps (columns); the full-load tables have the same values as the empty tables; the comment lines at the top are kept).

{2}

For tables written directly to files, the previous contents are kept in the same folder as "name.datetime.bak".</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Rw.079">Confirm</sys:String>
    <!-- ・{0}：{1}（前の中身：{2}） -->
    <sys:String x:Key="Rw.080">• {0}: {1} (previous contents: {2})</sys:String>
    <!-- ・{0}：{1} 　{2} -->
    <sys:String x:Key="Rw.081">• {0}: {1}
  {2}</sys:String>
    <!-- 次のファイルに書きました。  {0} -->
    <sys:String x:Key="Rw.082">Written to the following files.

{0}</sys:String>
    <!-- {0}次のファイルは書けませんでした。  {1} -->
    <sys:String x:Key="Rw.083">{0}The following files could not be written.

{1}</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Rw.084">Confirm</sys:String>
    <!-- 抵抗制御で作る -->
    <sys:String x:Key="Rw.085">Create for Resistance Control</sys:String>
</ResourceDictionary>
