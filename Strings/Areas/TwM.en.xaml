<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- TableWindow.MotorNoise.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- {0} 行目の{1}「{2}」 -->
    <sys:String x:Key="TwM.001">{1} "{2}" on line {0}</sys:String>
    <!-- 　ほか {0} か所 -->
    <sys:String x:Key="TwM.002">  and {0} more</sys:String>
    <!-- 音量が 0～1 でないセル（1 が元の音量）：{0}{1} -->
    <sys:String x:Key="TwM.003">Cells whose volume is not 0 to 1 (1 is the original volume): {0}{1}</sys:String>
    <!-- ピッチがマイナスのセル（1 が元の高さ）：{0}{1} -->
    <sys:String x:Key="TwM.004">Cells whose pitch is negative (1 is the original pitch): {0}{1}</sys:String>
    <!-- サウンドのファイルを読み込めていないので、音の列が Sound.txt の [Motor] にあるかは調べられません。 -->
    <sys:String x:Key="TwM.005">The sound file is not loaded, so it cannot be checked whether the sound columns are in [Motor] of Sound.txt.</sys:String>
    <!-- ・ -->
    <sys:String x:Key="TwM.006">,</sys:String>
    <!--  ほか {0} 列 -->
    <sys:String x:Key="TwM.007"> and {0} more columns</sys:String>
    <!-- {0}{1} は Sound.txt の [Motor] に書かれていないので鳴りません（サウンドのタブの [Motor] で番号を足せます）。 -->
    <sys:String x:Key="TwM.008">{0}{1} are not written in [Motor] of Sound.txt, so they are not played (you can add the numbers in [Motor] on the Sound tab).</sys:String>
</ResourceDictionary>
