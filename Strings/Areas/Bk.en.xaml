<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- BackupWindow.xaml.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 残す数は {0}～{1} の整数にしてください（「{2}」）。 -->
    <sys:String x:Key="Bk.001">The number of copies must be a whole number from {0} to {1} ("{2}").</sys:String>
    <!-- 自動保存の間隔は {0}～{1} の整数にしてください（「{2}」）。 -->
    <sys:String x:Key="Bk.002">The autosave interval must be a whole number from {0} to {1} ("{2}").</sys:String>
</ResourceDictionary>
