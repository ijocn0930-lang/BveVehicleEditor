<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- ResistanceBrakeWindow.xaml の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 抵抗制御で作る - ブレーキ -->
    <sys:String x:Key="RbX.001">Create for Resistance Control - Brake</sys:String>
    <!-- 発電ブレーキの式で、段ごとの表（列が段）を作ります。速い速度から下がり、電流が限流値まで下がると次の段（抵抗の小さい段）へ進みます。段 1 がいちばん速い速度で使われ、最後の段より遅くなると電流が保てずにブレーキが弱まります。満車の表は空車と同じ値で作ります（満車は進段パラメーターの限流値が変わるだけです）。 -->
    <sys:String x:Key="RbX.002">Creates a table with one column per step using the dynamic brake formula. Going down from high speed, when the current falls to the current limit it advances to the next step (lower resistance). Step 1 is used at the highest speed; below the last step the current cannot be kept and the brake weakens. The full-load tables are made with the same values as the empty tables (at full load only the current limit in the step parameters changes).</sys:String>
    <!-- 作る表 -->
    <sys:String x:Key="RbX.003">Tables to create</sys:String>
    <!-- チェックした表をまとめて作ります。開いている表は画面の表を置き換えます（保存するまでファイルは変わりません）。ほかの表は、確認してからファイルに直接書きます（書く前の中身は同じフォルダーに .bak で残します）。 -->
    <sys:String x:Key="RbX.004">Creates the checked tables at once. The open table replaces the table in the window (the file does not change until you save). The other tables are written directly to their files after confirming (the previous contents are kept in the same folder as .bak).</sys:String>
    <!-- グラフで見る表： -->
    <sys:String x:Key="RbX.005">Table shown in the graph:</sys:String>
    <!-- 段と限流値 -->
    <sys:String x:Key="RbX.006">Steps and current limit</sys:String>
    <!-- 段の数 -->
    <sys:String x:Key="RbX.007">Number of steps</sys:String>
    <!-- ブレーキの段の数（表の列の数） -->
    <sys:String x:Key="RbX.008">Number of brake steps (number of table columns)</sys:String>
    <!-- 限流値 [A] -->
    <sys:String x:Key="RbX.009">Current limit [A]</sys:String>
    <!-- 進段パラメーターの CurrentLimitingValue_Empty（空車）。段ごとに違うときは、いちばん多い値 -->
    <sys:String x:Key="RbX.010">CurrentLimitingValue_Empty (empty car) in the step parameters. If it differs per step, the most common value</sys:String>
    <!-- 限流値の力 [N] -->
    <sys:String x:Key="RbX.011">Force at current limit [N]</sys:String>
    <!-- 電流が限流値のときのブレーキの力（M 車 1 両あたり） -->
    <sys:String x:Key="RbX.012">Brake force when the current is at the current limit (per M car)</sys:String>
    <!-- 段 1 [km/h] -->
    <sys:String x:Key="RbX.013">Step 1 [km/h]</sys:String>
    <!-- いちばん速い段（段 1）の電流が限流値まで下がる速度 -->
    <sys:String x:Key="RbX.014">Speed at which the current of the fastest step (step 1) falls to the current limit</sys:String>
    <!-- 最後の段 [km/h] -->
    <sys:String x:Key="RbX.015">Last step [km/h]</sys:String>
    <!-- 最後の段の電流が限流値まで下がる速度。これより遅いとブレーキが弱まります -->
    <sys:String x:Key="RbX.016">Speed at which the current of the last step falls to the current limit. Below this the brake weakens</sys:String>
    <!-- 飽和の強さ s -->
    <sys:String x:Key="RbX.017">Saturation s</sys:String>
    <!-- 小さいほど鉄心の飽和が強い（ふつう 0.2～5。既定 1）。ブレーキが弱まり始めてから 0 になるまでの速さにも効きます -->
    <sys:String x:Key="RbX.018">Smaller means stronger core saturation (usually 0.2 to 5; default 1). It also affects how fast the brake goes from weakening to 0</sys:String>
    <!-- 電圧の下がり b -->
    <sys:String x:Key="RbX.019">Voltage drop b</sys:String>
    <!-- 速度が上がるほど電動機の起こす電圧が下がる割合 [1/(km/h)]（φ(x) − b × 速度）。大きいほど速い段で電流が増えにくくなります（ふつう 0～0.003。既定 0） -->
    <sys:String x:Key="RbX.020">Rate at which the voltage generated by the motor drops as speed increases [1/(km/h)] (φ(x) − b × speed). The larger it is, the less the current increases in the fast steps (usually 0 to 0.003; default 0)</sys:String>
    <!-- 限流値より上の飽和 -->
    <sys:String x:Key="RbX.021">Saturation above current limit</sys:String>
    <!-- 電流が限流値より大きいときだけ使う飽和の強さ。s より小さくすると、段が切り替わったあと電流が増えにくくなります（0 なら s と同じ。既定 0） -->
    <sys:String x:Key="RbX.022">Saturation used only when the current is above the current limit. Smaller than s makes the current increase less after switching steps (0 means the same as s; default 0)</sys:String>
    <!-- 今の表に合わせる -->
    <sys:String x:Key="RbX.023">Fit to current table</sys:String>
    <!-- 段ごとの切り替わる速度 [km/h]（速い順に「,」で区切る。空なら段 1 と最後の段の間を同じ比で並べる） -->
    <sys:String x:Key="RbX.024">Switching speed of each step [km/h] (fastest first, separated by ","; if empty, arranged with the same ratio between step 1 and the last step)</sys:String>
    <!-- その段の電流が段の限流値まで下がって、次の段へ進む速度。数は段の数と同じにします。「今の表に合わせる」で、今の表の値を写したほうが合うときは入ります -->
    <sys:String x:Key="RbX.025">Speed at which the current of the step falls to its current limit and it advances to the next step. The count must equal the number of steps. "Fit to current table" fills them in when copying the current table's values fits better</sys:String>
    <!-- 表の形 -->
    <sys:String x:Key="RbX.026">Table shape</sys:String>
    <!-- 最高速度 [km/h] -->
    <sys:String x:Key="RbX.027">Maximum speed [km/h]</sys:String>
    <!-- 表の最後の行の速度 -->
    <sys:String x:Key="RbX.028">Speed of the last row of the table</sys:String>
    <!-- 速度の刻み [km/h] -->
    <sys:String x:Key="RbX.029">Speed step [km/h]</sys:String>
    <!-- 表の行の速度の間隔 -->
    <sys:String x:Key="RbX.030">Speed interval between table rows</sys:String>
    <!-- 表に入れる -->
    <sys:String x:Key="RbX.031">Put into tables</sys:String>
    <!-- チェックした表を作ります（開いている表は画面で置き換え、ほかの表はファイルに直接書きます。先頭のコメントの行は残します） -->
    <sys:String x:Key="RbX.032">Creates the checked tables (the open table is replaced in the window, the others are written directly to their files; the comment lines at the top are kept)</sys:String>
    <!-- 閉じる -->
    <sys:String x:Key="RbX.033">Close</sys:String>
</ResourceDictionary>
