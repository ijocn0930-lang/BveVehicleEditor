<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- EditorTemplates.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 運転台（ツーハンドル） -->
    <sys:String x:Key="Tpl.001">Cab (two handles)</sys:String>
    <!-- 運転台（ワンハンドル） -->
    <sys:String x:Key="Tpl.002">Cab (one handle)</sys:String>
    <!-- 定速運転装置 -->
    <sys:String x:Key="Tpl.003">Constant speed control</sys:String>
    <!-- 主制御装置 -->
    <sys:String x:Key="Tpl.004">Main circuit</sys:String>
    <!-- 再粘着制御 -->
    <sys:String x:Key="Tpl.005">Re-adhesion control</sys:String>
    <!-- ブレーキ方式（電気指令式） -->
    <sys:String x:Key="Tpl.006">Brake system (electric command)</sys:String>
    <!-- ブレーキ方式（電磁直通） -->
    <sys:String x:Key="Tpl.007">Brake system (electromagnetic straight air)</sys:String>
    <!-- ブレーキ方式（自動空気） -->
    <sys:String x:Key="Tpl.008">Brake system (automatic air)</sys:String>
    <!-- 直通管の圧力調整弁 -->
    <sys:String x:Key="Tpl.009">Straight air pipe pressure regulator</sys:String>
    <!-- 釣り合い空気ダメ -->
    <sys:String x:Key="Tpl.010">Equalizing reservoir</sys:String>
    <!-- ブレーキ管 -->
    <sys:String x:Key="Tpl.011">Brake pipe</sys:String>
    <!-- 電空協調制御（遅れ込め） -->
    <sys:String x:Key="Tpl.012">Electro-pneumatic blending (delayed application)</sys:String>
    <!-- 電空協調制御（締切電磁弁） -->
    <sys:String x:Key="Tpl.013">Electro-pneumatic blending (lockout valve)</sys:String>
    <!-- ブレーキシリンダーの圧力調整弁 -->
    <sys:String x:Key="Tpl.014">Brake cylinder pressure regulator</sys:String>
    <!-- ブレーキシリンダーの圧力調整弁（サーボ） -->
    <sys:String x:Key="Tpl.015">Brake cylinder pressure regulator (servo)</sys:String>
    <!-- 基礎ブレーキ装置 -->
    <sys:String x:Key="Tpl.016">Foundation brake</sys:String>
    <!-- 滑走再粘着制御 -->
    <sys:String x:Key="Tpl.017">Slide re-adhesion control</sys:String>
    <!-- 空気圧縮機 -->
    <sys:String x:Key="Tpl.018">Air compressor</sys:String>
    <!-- 力学パラメーター -->
    <sys:String x:Key="Tpl.019">Dynamics</sys:String>
    <!-- 乗客 -->
    <sys:String x:Key="Tpl.020">Passengers</sys:String>
    <!-- 客室ドア -->
    <sys:String x:Key="Tpl.021">Passenger doors</sys:String>
    <!-- 運転士の視点 -->
    <sys:String x:Key="Tpl.022">Driver's viewpoint</sys:String>
    <!-- もう書かれています -->
    <sys:String x:Key="Tpl.023">already written</sys:String>
    <!-- もう書かれています -->
    <sys:String x:Key="Tpl.024">already written</sys:String>
    <!-- もう書かれています -->
    <sys:String x:Key="Tpl.025">already written</sys:String>
    <!-- もう書かれています -->
    <sys:String x:Key="Tpl.026">already written</sys:String>
    <!-- [{0}] が書かれているので書けません -->
    <sys:String x:Key="Tpl.027">cannot be written because [{0}] is written</sys:String>
    <!-- 力行 -->
    <sys:String x:Key="Tpl.028">Power</sys:String>
    <!-- ブレーキ -->
    <sys:String x:Key="Tpl.029">Brake</sys:String>
    <!-- もう書かれています -->
    <sys:String x:Key="Tpl.030">already written</sys:String>
    <!-- カーソルを [Power] か [Brake] の中に置いてください -->
    <sys:String x:Key="Tpl.031">place the cursor inside [Power] or [Brake]</sys:String>
    <!-- [{0}] にもう書かれています -->
    <sys:String x:Key="Tpl.032">already written in [{0}]</sys:String>
</ResourceDictionary>
