<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- ChartBuilder.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 速度 -->
    <sys:String x:Key="Ch.001">Speed</sys:String>
    <!-- {0} 速度: {2:0.##} km/h 値: {4:0.###} -->
    <sys:String x:Key="Ch.002">{0}
Speed: {2:0.##} km/h
Value: {4:0.###}</sys:String>
    <!-- {0}（とても大きい値は軸の外） -->
    <sys:String x:Key="Ch.003">{0} (very large values are off the axis)</sys:String>
    <!-- 線が {0} 本なので凡例は省略（マウスを乗せると名前） -->
    <sys:String x:Key="Ch.005">{0} lines, so the legend is omitted (hover to see the names)</sys:String>
    <!-- {0} 速度: {2:0.##} km/h 値: {4:0.###} -->
    <sys:String x:Key="Ch.006">{0}
Speed: {2:0.##} km/h
Value: {4:0.###}</sys:String>
    <!-- {0} 速度: {2:0.##} km/h 値: {4:0.###} -->
    <sys:String x:Key="Ch.007">{0}
Speed: {2:0.##} km/h
Value: {4:0.###}</sys:String>
</ResourceDictionary>
