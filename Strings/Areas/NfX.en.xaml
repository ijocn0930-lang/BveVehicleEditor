<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- NotchForm.xaml の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 表のファイル（CSV）を「参照」で選ぶと、下のテキストが書き換わります（テキストをクリックして Ctrl+Z で戻せます）。パスは Notch.txt からの相対パスです。「開く」で、表のファイルを別のウィンドウで表の形で見られます。 -->
    <sys:String x:Key="NfX.001">When you choose a table file (CSV) with "Browse", the text below is rewritten (click the text and press Ctrl+Z to undo). Paths are relative to Notch.txt. "Open" shows the table file as a table in another window.</sys:String>
    <!-- [Power] 力行（加速）ノッチ -->
    <sys:String x:Key="NfX.002">[Power] Power notches</sys:String>
    <!-- [Brake] ブレーキノッチ -->
    <sys:String x:Key="NfX.003">[Brake] Brake notches</sys:String>
</ResourceDictionary>
