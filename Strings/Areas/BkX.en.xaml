<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- BackupWindow.xaml の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- バックアップの設定 -->
    <sys:String x:Key="BkX.001">Backup Settings</sys:String>
    <!-- 「すべて保存」でファイルを上書きする前に、前の中身を控え（.bak）として残します。間違えて保存したときは、控えを開いて中身を戻せます。 -->
    <sys:String x:Key="BkX.002">Before "Save All" overwrites a file, the previous contents are kept as a backup (.bak). If you saved by mistake, you can open the backup and restore the contents.</sys:String>
    <!-- 保存の前に控えを残す -->
    <sys:String x:Key="BkX.003">Keep a backup before saving</sys:String>
    <!-- 1 つのファイルにつき残す数 -->
    <sys:String x:Key="BkX.004">Copies to keep per file</sys:String>
    <!-- 1～100（多いときは古いものから消します） -->
    <sys:String x:Key="BkX.005">1 to 100 (older copies are deleted when there are more)</sys:String>
    <!-- 個（1～100） -->
    <sys:String x:Key="BkX.006">copies (1 to 100)</sys:String>
    <!-- 置き場所（車両ファイルごとにフォルダーを分けます。「ヘルプ → バックアップのフォルダーを開く」で開けます） -->
    <sys:String x:Key="BkX.007">Location (a separate folder for each vehicle file; you can open it with "Help → Open Backup Folder")</sys:String>
    <!-- 自動保存は、保存していない編集中の中身を、決まった間隔で控えとして残します。車両ファイルは書き換えません（BVE が読むファイルは「すべて保存」のときだけ変わります）。普通に閉じたときは控えを消します。 -->
    <sys:String x:Key="BkX.008">Autosave keeps the unsaved contents you are editing as a backup at regular intervals. The vehicle files are not changed (the files BVE reads change only when you use "Save All"). The backup is deleted when the app is closed normally.</sys:String>
    <!-- 自動保存する -->
    <sys:String x:Key="BkX.009">Autosave</sys:String>
    <!-- 間隔 -->
    <sys:String x:Key="BkX.010">Interval</sys:String>
    <!-- 1～60 分（変更がないときは保存しません） -->
    <sys:String x:Key="BkX.011">1 to 60 minutes (nothing is saved when there are no changes)</sys:String>
    <!-- 分ごと（1～60） -->
    <sys:String x:Key="BkX.012">minutes (1 to 60)</sys:String>
    <!-- 自動保存の置き場所 -->
    <sys:String x:Key="BkX.013">Autosave location</sys:String>
    <!-- 初めに戻す -->
    <sys:String x:Key="BkX.014">Reset</sys:String>
    <!-- 控えを残す・10 個・自動保存する・5 分ごとにします（OK で当てはめます） -->
    <sys:String x:Key="BkX.015">Sets: keep backups, 10 copies, autosave, every 5 minutes (applied when you press OK)</sys:String>
    <!-- キャンセル -->
    <sys:String x:Key="BkX.016">Cancel</sys:String>
</ResourceDictionary>
