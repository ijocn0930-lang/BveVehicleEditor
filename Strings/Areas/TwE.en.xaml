<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- TableWindow.Editing.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- クリップボードを使えませんでした。ほかのアプリがクリップボードを使っているかもしれません。少し待ってから、もう一度試してください。 -->
    <sys:String x:Key="TwE.001">The clipboard could not be used. Another app may be using it. Wait a moment and try again.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="TwE.002">Confirm</sys:String>
    <!-- クリップボードを使えませんでした。ほかのアプリがクリップボードを使っているかもしれません。少し待ってから、もう一度試してください。 -->
    <sys:String x:Key="TwE.003">The clipboard could not be used. Another app may be using it. Wait a moment and try again.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="TwE.004">Confirm</sys:String>
    <!-- 足す場所の列のセルを選んでから押してください。 -->
    <sys:String x:Key="TwE.005">Select a cell in the column where you want to add first.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="TwE.006">Confirm</sys:String>
    <!-- {0}の列の左には、列を足せません。 -->
    <sys:String x:Key="TwE.007">A column cannot be added to the left of the {0} column.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="TwE.008">Confirm</sys:String>
    <!-- 消す列（{0}）のセルを選んでから押してください。左の「行」と{1}の列は消せません。 -->
    <sys:String x:Key="TwE.009">Select cells in the columns ({0}) to delete first. The "Row" column and the {1} column cannot be deleted.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="TwE.010">Confirm</sys:String>
    <!-- ・ -->
    <sys:String x:Key="TwE.011">,</sys:String>
    <!-- {0} の列を消しますか？ すべての行のこの列の値が消え、右の列が左へ詰まります。  保存するまでファイルは変わりません。保存せずに閉じれば元に戻ります。 -->
    <sys:String x:Key="TwE.012">Delete the {0} column(s)?
The values in these columns of all rows are deleted and the columns on the right move left.

The file does not change until you save. Closing without saving restores it.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="TwE.013">Confirm</sys:String>
</ResourceDictionary>
