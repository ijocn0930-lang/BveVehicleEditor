<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- PerformanceParams.cs の文（日本語）。英語は PP.en.xaml -->
    <sys:String x:Key="PP.001">秒</sys:String>
    <sys:String x:Key="PP.002">断流器遅れ時間（入）</sys:String>
    <sys:String x:Key="PP.003">秒</sys:String>
    <sys:String x:Key="PP.004">断流器遅れ時間（切）</sys:String>
    <sys:String x:Key="PP.005">秒</sys:String>
    <sys:String x:Key="PP.006">断流器を切ったあと、入れられるようになるまでの時間</sys:String>
    <sys:String x:Key="PP.007">秒</sys:String>
    <sys:String x:Key="PP.008">減流遮断の減流時間（減流遮断をしないなら 0）</sys:String>
    <sys:String x:Key="PP.009">ジャーク制御（増）（ジャーク制御をしないなら 0）</sys:String>
    <sys:String x:Key="PP.010">ジャーク制御（減）（ジャーク制御をしないなら 0）</sys:String>
    <sys:String x:Key="PP.011">次の段に進むのに必要な最小のハンドル位置（力行・抑速のとき）</sys:String>
    <sys:String x:Key="PP.012">前の段に戻るのに必要な最大のハンドル位置（戻さないなら 0、惰行で初期段に戻さないなら -1）</sys:String>
    <sys:String x:Key="PP.013">秒</sys:String>
    <sys:String x:Key="PP.014">次の段に進むのにかかる時間</sys:String>
    <sys:String x:Key="PP.015">秒</sys:String>
    <sys:String x:Key="PP.016">前の段に戻るのにかかる時間</sys:String>
    <sys:String x:Key="PP.017">次の段に進める最大の電流（空車）</sys:String>
    <sys:String x:Key="PP.018">次の段に進める最大の電流（応荷重最大）</sys:String>
    <sys:String x:Key="PP.019">空車限流値（CurrentLimitingValue_Empty と同じ働きと思われる）</sys:String>
    <sys:String x:Key="PP.020">最大限流値（CurrentLimitingValue_Full と同じ働きと思われる）</sys:String>
    <sys:String x:Key="PP.021">⚠ 一覧にない項目名</sys:String>
    <sys:String x:Key="PP.022">（{0:0.00} からの項目）</sys:String>
</ResourceDictionary>
