<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- FontWindow.xaml の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- フォント -->
    <sys:String x:Key="FoX.001">Font</sys:String>
    <!-- 6 つのタブのテキストエリアの文字に使います。等幅のフォント（文字の幅がそろうもの）がおすすめです。BIZ UDゴシック・MS ゴシックは日本語のコメントも同じフォントで出ます。 -->
    <sys:String x:Key="FoX.002">Used for the text areas of the six tabs. A monospaced font (all characters have the same width) is recommended. With BIZ UDGothic or MS Gothic, Japanese comments are also shown in the same font.</sys:String>
    <!-- フォント -->
    <sys:String x:Key="FoX.003">Font</sys:String>
    <!-- 上はおすすめの等幅のフォント（この PC に入っているものだけ）、下はこの PC に入っているすべてのフォント -->
    <sys:String x:Key="FoX.004">The top part lists recommended monospaced fonts (only those installed on this PC); the bottom part lists all fonts installed on this PC</sys:String>
    <!-- 大きさ -->
    <sys:String x:Key="FoX.005">Size</sys:String>
    <!-- 8～40（Ctrl+マウスホイールでも変えられます） -->
    <sys:String x:Key="FoX.006">8 to 40 (you can also change it with Ctrl+mouse wheel)</sys:String>
    <!-- 見本 -->
    <sys:String x:Key="FoX.007">Preview</sys:String>
    <!-- 初めに戻す -->
    <sys:String x:Key="FoX.008">Reset</sys:String>
    <!-- Consolas・13 にします（OK で当てはめます） -->
    <sys:String x:Key="FoX.009">Sets Consolas, 13 (applied when you press OK)</sys:String>
    <!-- キャンセル -->
    <sys:String x:Key="FoX.010">Cancel</sys:String>
</ResourceDictionary>
