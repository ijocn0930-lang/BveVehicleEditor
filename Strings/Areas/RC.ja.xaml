<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- ResistanceCalculator.cs の文（日本語）。英語は RC.en.xaml -->
    <sys:String x:Key="RC.001">起動</sys:String>
    <sys:String x:Key="RC.002">直列</sys:String>
    <sys:String x:Key="RC.003">抵抗</sys:String>
    <sys:String x:Key="RC.004">並列</sys:String>
    <sys:String x:Key="RC.005">弱め界磁</sys:String>
    <sys:String x:Key="RC.006">限流値は 0 より大きくしてください。</sys:String>
    <sys:String x:Key="RC.007">全界磁の段で限流値まで下がる速度は 0 より大きくしてください。</sys:String>
    <sys:String x:Key="RC.008">そのときの力は 0 より大きくしてください。</sys:String>
    <sys:String x:Key="RC.009">起動の段の数はマイナスにできません。</sys:String>
    <sys:String x:Key="RC.010">直列（抵抗）の段の数は 1 以上にしてください。</sys:String>
    <sys:String x:Key="RC.011">起動の段の数は、直列（抵抗）の段の数以下にしてください（起動の段は直列の段に含みます）。</sys:String>
    <sys:String x:Key="RC.012">並列の段の数はマイナスにできません（つなぎ替えがなければ 0）。</sys:String>
    <sys:String x:Key="RC.013">段が多すぎます（全部で {0} 段までにしてください）。</sys:String>
    <sys:String x:Key="RC.014">弱め界磁 {0}：界磁の割合は 0 より大きく 1（100%）以下にしてください。</sys:String>
    <sys:String x:Key="RC.015">弱め界磁の段の限流値は 0 より大きくしてください。</sys:String>
    <sys:String x:Key="RC.016">飽和の強さ s は 0 より大きくしてください（ふつう 0.2～5）。</sys:String>
    <sys:String x:Key="RC.017">電動機の中の抵抗 r は 0 より大きく 0.5 より小さくしてください（ふつう 0.03～0.3）。</sys:String>
    <sys:String x:Key="RC.018">損失 L はマイナスにできません。</sys:String>
    <sys:String x:Key="RC.019">弱め界磁の飽和 s はマイナスにできません（0 か空なら全界磁と同じ）。</sys:String>
    <sys:String x:Key="RC.020">弱め界磁の中の抵抗 r は 0 以上 0.5 より小さくしてください（0 か空なら全界磁と同じ）。</sys:String>
    <sys:String x:Key="RC.021">弱め界磁の力の指数 q は 0～3 にしてください（0 か空なら飽和の形のまま）。</sys:String>
    <sys:String x:Key="RC.022">最高速度は 0 より大きくしてください。</sys:String>
    <sys:String x:Key="RC.023">速度の刻みは 0 より大きくしてください。</sys:String>
    <sys:String x:Key="RC.024">直列のときの電圧の割合は {0}～{1} にしてください（ふつう 0.5）。</sys:String>
    <sys:String x:Key="RC.025">段ごとの切り替わる速度の数（{0} 個）を、起動の次からの直列と並列の段の数（{1}）と同じにするか、空にしてください。</sys:String>
    <sys:String x:Key="RC.026">段ごとの切り替わる速度は、0 以上で、だんだん大きくなる（同じでもよい）並びにしてください。</sys:String>
</ResourceDictionary>
