<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- FileItem.cs の文（日本語）。英語は FI.en.xaml -->
    <sys:String x:Key="FI.001">ファイル '{0}' の形式が正しくありません。
</sys:String>
    <sys:String x:Key="FI.002">期待されるヘッダー: '{0}'
</sys:String>
    <sys:String x:Key="FI.003">実際の先頭行: '{0}'

</sys:String>
    <sys:String x:Key="FI.004">このファイルを指定したままだと、BVE でも「File format is not valid.」のエラーになります。</sys:String>
    <sys:String x:Key="FI.005">{0} 行目の「{1}」</sys:String>
    <sys:String x:Key="FI.006">ファイル '{0}' は、ノッチ（PerformanceCurve）やモーター音（MotorNoise）のファイルではないようです。
</sys:String>
    <sys:String x:Key="FI.007">1行目: '{0}'

</sys:String>
    <sys:String x:Key="FI.008">パラメーター・パネル・サウンドなど、別の種類のファイルを選んでいないか確認してください。</sys:String>
    <sys:String x:Key="FI.009">ヘッダーの文字コード名「{0}」が分かりません（utf-8 / shift_jis など）</sys:String>
    <sys:String x:Key="FI.010">ヘッダーに文字コードの指定がないため BVE は UTF-8 として読みますが、ファイルは {0} で保存されています</sys:String>
    <sys:String x:Key="FI.011">ヘッダーは「{0}」ですが、ファイルは {1} で保存されています</sys:String>
</ResourceDictionary>
