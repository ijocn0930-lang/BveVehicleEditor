<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- ResistanceWindow.xaml の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 抵抗制御で作る -->
    <sys:String x:Key="RwX.001">Create for Resistance Control</sys:String>
    <!-- 直巻電動機の式で、進段ごとの表（列が段）を作ります。電流が限流値まで下がると次の段へ進み、直列 → 並列 → 弱め界磁の順に進みます。直列・並列の中の段の抵抗は、同じ跳ね上がりの倍率で進み、最後の段でちょうど抵抗 0 になるように決めます。満車の表は空車と同じ値で作ります（満車は進段パラメーターの限流値が変わるだけです）。 -->
    <sys:String x:Key="RwX.002">Creates a table with one column per step using the series-wound motor formula. When the current falls to the current limit, it advances to the next step, in the order series → parallel → field weakening. The resistance of the steps within series and parallel advances with the same jump ratio, chosen so that the resistance becomes exactly 0 at the last step. The full-load tables are made with the same values as the empty tables (at full load only the current limit in the step parameters changes).</sys:String>
    <!-- 作る表 -->
    <sys:String x:Key="RwX.003">Tables to create</sys:String>
    <!-- チェックした表をまとめて作ります。開いている表は画面の表を置き換えます（保存するまでファイルは変わりません）。ほかの表は、確認してからファイルに直接書きます（書く前の中身は同じフォルダーに .bak で残します）。 -->
    <sys:String x:Key="RwX.004">Creates the checked tables at once. The open table replaces the table in the window (the file does not change until you save). The other tables are written directly to their files after confirming (the previous contents are kept in the same folder as .bak).</sys:String>
    <!-- グラフで見る表： -->
    <sys:String x:Key="RwX.005">Table shown in the graph:</sys:String>
    <!-- 段の数と限流値 -->
    <sys:String x:Key="RwX.006">Steps and current limit</sys:String>
    <!-- 起動の段の数 -->
    <sys:String x:Key="RwX.007">Starting steps</sys:String>
    <!-- 速度 0 で次々に進む段の数（直列の段に含みます）。サンプルでは 2～5 -->
    <sys:String x:Key="RwX.008">Number of steps that advance one after another at speed 0 (included in the series steps). 2 to 5 in the samples</sys:String>
    <!-- 直列の段の数（S） -->
    <sys:String x:Key="RwX.009">Series steps (S)</sys:String>
    <!-- 直並列のつなぎ替えがなければ、抵抗の段の全部の数 -->
    <sys:String x:Key="RwX.010">Without series-parallel switching, the total number of resistance steps</sys:String>
    <!-- 並列の段の数（P） -->
    <sys:String x:Key="RwX.011">Parallel steps (P)</sys:String>
    <!-- 直並列のつなぎ替えがなければ 0 -->
    <sys:String x:Key="RwX.012">0 without series-parallel switching</sys:String>
    <!-- 弱め界磁の段の数（WF） -->
    <sys:String x:Key="RwX.013">Field weakening steps (WF)</sys:String>
    <!-- 下の「界磁の割合」の数と同じにします -->
    <sys:String x:Key="RwX.014">Same as the number of "field ratios" below</sys:String>
    <!-- 限流値 [A] -->
    <sys:String x:Key="RwX.015">Current limit [A]</sys:String>
    <!-- 進段パラメーターの CurrentLimitingValue_Empty（空車） -->
    <sys:String x:Key="RwX.016">CurrentLimitingValue_Empty (empty car) in the step parameters</sys:String>
    <!-- 弱め界磁の段の限流値 [A] -->
    <sys:String x:Key="RwX.017">Field weakening current limit [A]</sys:String>
    <!-- ふつうは上の限流値と同じ（211 系は 360 A） -->
    <sys:String x:Key="RwX.018">Usually the same as the current limit above (360 A for the 211 series)</sys:String>
    <!-- 直列の電圧の割合 -->
    <sys:String x:Key="RwX.019">Series voltage ratio</sys:String>
    <!-- 直列のときの電圧（並列を 1 として。ふつう 0.5）。大きいほど直列の段が速い速度まで続きます（南海 6000 は 0.73）。今の表があれば、直列が終わる速度から入れます -->
    <sys:String x:Key="RwX.020">Voltage in series (parallel = 1; usually 0.5). The larger it is, the higher the speed the series steps continue to (0.73 for the Nankai 6000). If there is a current table, it is set from the speed where series ends</sys:String>
    <!-- 弱め界磁の界磁の割合 [%]（段ごとに「,」で区切る。界磁の電流の割合） -->
    <sys:String x:Key="RwX.021">Field weakening field ratios [%] (separated by "," per step; ratio of field current)</sys:String>
    <!-- 例：80,65,50,40。数は弱め界磁の段の数と同じにします。「今の表に合わせる」で、今の表から読んだ値が入ります -->
    <sys:String x:Key="RwX.022">Example: 80,65,50,40. The count must equal the number of field weakening steps. "Fit to current table" sets the values read from the current table</sys:String>
    <!-- 段ごとの切り替わる速度 [km/h]（起動の次からの直列・並列の段。「,」で区切る。空なら同じ跳ね上がりの倍率で進む） -->
    <sys:String x:Key="RwX.023">Switching speed of each step [km/h] (series and parallel steps after the starting steps, separated by ","; if empty, they advance with the same jump ratio)</sys:String>
    <!-- その段の電流が限流値まで下がって、次の段へ進む速度。数は「直列の段の数 − 起動の段の数 ＋ 並列の段の数」と同じにします（区間の最後の段は抵抗 0 なので、その段の値は使いません）。「今の表に合わせる」で、今の表の値を写したほうが合うときは入ります -->
    <sys:String x:Key="RwX.024">Speed at which the current of the step falls to the current limit and it advances to the next step. The count must be "series steps − starting steps + parallel steps" (the last step of each range has zero resistance, so its value is not used). "Fit to current table" fills them in when copying the current table's values fits better</sys:String>
    <!-- 全界磁の点と電動機の形 -->
    <sys:String x:Key="RwX.025">Full-field point and motor shape</sys:String>
    <!-- 全並列・全界磁の段（弱め界磁の 1 つ前の段）で、電流が限流値まで下がる速度と、そのときの力（M 車 1 両あたり）です。電動機の形（飽和 s・中の抵抗 r・損失 L）は車両ごとに違います。「今の表に合わせる」を押すと、開いている表とノッチのファイルに書かれた表から、全界磁の点・界磁の割合・電動機の形を選び直します（全ノッチで走ったときの力・電流と、0 から加速したときの到達時間が合うように選びます。到達時間を合わせるため、全界磁の力は今の表より数 % 大きくなることがあります）。 -->
    <sys:String x:Key="RwX.026">Speed at which the current falls to the current limit in the full-parallel, full-field step (the step before field weakening), and the force at that time (per M car). The motor shape (saturation s, internal resistance r, loss L) differs for each vehicle. "Fit to current table" re-chooses the full-field point, field ratios and motor shape from the open table and the tables written in the notch file (so that the force and current at full notch and the time to reach each speed from 0 match. To match the times, the full-field force may become a few % larger than the current table).</sys:String>
    <!-- 全界磁 [km/h] -->
    <sys:String x:Key="RwX.027">Full field [km/h]</sys:String>
    <!-- 全並列・全界磁の段で、電流が限流値まで下がる速度 -->
    <sys:String x:Key="RwX.028">Speed at which the current falls to the current limit in the full-parallel, full-field step</sys:String>
    <!-- 全界磁の力 [N] -->
    <sys:String x:Key="RwX.029">Full-field force [N]</sys:String>
    <!-- そのときの力（M 車 1 両あたり） -->
    <sys:String x:Key="RwX.030">Force at that time (per M car)</sys:String>
    <!-- 飽和の強さ s -->
    <sys:String x:Key="RwX.031">Saturation s</sys:String>
    <!-- 小さいほど鉄心の飽和が強い（ふつう 0.2～5。既定 1） -->
    <sys:String x:Key="RwX.032">Smaller means stronger core saturation (usually 0.2 to 5; default 1)</sys:String>
    <!-- 電動機の中の抵抗 r -->
    <sys:String x:Key="RwX.033">Motor internal resistance r</sys:String>
    <!-- 限流値のときの電圧降下が電圧の何割か（ふつう 0.03～0.3。既定 0.2） -->
    <sys:String x:Key="RwX.034">Voltage drop at the current limit as a fraction of the voltage (usually 0.03 to 0.3; default 0.2)</sys:String>
    <!-- 損失 L -->
    <sys:String x:Key="RwX.035">Loss L</sys:String>
    <!-- 全界磁の点の速度での損失が、そのときの力の何割か（速度の 2 乗で増える。ふつう 0～0.03。既定 0） -->
    <sys:String x:Key="RwX.036">Loss at the full-field point speed as a fraction of the force at that time (increases with the square of speed; usually 0 to 0.03; default 0)</sys:String>
    <!-- 弱め界磁の飽和 s -->
    <sys:String x:Key="RwX.037">Field weakening saturation s</sys:String>
    <!-- 弱め界磁の段だけに使う飽和の強さ（空なら全界磁と同じ）。「今の表に合わせる」で、合うときは入ります -->
    <sys:String x:Key="RwX.038">Saturation used only for field weakening steps (if empty, the same as full field). "Fit to current table" fills it in when it fits</sys:String>
    <!-- 弱め界磁の中の抵抗 r -->
    <sys:String x:Key="RwX.039">Field weakening internal resistance r</sys:String>
    <!-- 弱め界磁の段だけに使う中の抵抗（空なら全界磁と同じ）。小さいほど、弱め界磁に入るときの跳ね上がりが大きくなります -->
    <sys:String x:Key="RwX.040">Internal resistance used only for field weakening steps (if empty, the same as full field). The smaller it is, the larger the jump when entering field weakening</sys:String>
    <!-- 弱め界磁の力 q -->
    <sys:String x:Key="RwX.041">Field weakening force q</sys:String>
    <!-- 弱め界磁の段の力の形（限流値での磁束 ×（電流 ÷ 限流値）^q）。空なら飽和の形のまま。速度と電流の関係は変わりません。「今の表に合わせる」で、合うときは入ります -->
    <sys:String x:Key="RwX.042">Force shape of field weakening steps (flux at current limit × (current ÷ current limit)^q). If empty, the saturation shape is kept. The relation between speed and current does not change. "Fit to current table" fills it in when it fits</sys:String>
    <!-- 今の表に合わせる -->
    <sys:String x:Key="RwX.043">Fit to current table</sys:String>
    <!-- 表の形 -->
    <sys:String x:Key="RwX.044">Table shape</sys:String>
    <!-- 最高速度 [km/h] -->
    <sys:String x:Key="RwX.045">Maximum speed [km/h]</sys:String>
    <!-- 表の最後の行の速度 -->
    <sys:String x:Key="RwX.046">Speed of the last row of the table</sys:String>
    <!-- 速度の刻み [km/h] -->
    <sys:String x:Key="RwX.047">Speed step [km/h]</sys:String>
    <!-- 表の行の速度の間隔 -->
    <sys:String x:Key="RwX.048">Speed interval between table rows</sys:String>
    <!-- 表に入れる -->
    <sys:String x:Key="RwX.049">Put into tables</sys:String>
    <!-- チェックした表を作ります（開いている表は画面で置き換え、ほかの表はファイルに直接書きます。先頭のコメントの行は残します） -->
    <sys:String x:Key="RwX.050">Creates the checked tables (the open table is replaced in the window, the others are written directly to their files; the comment lines at the top are kept)</sys:String>
    <!-- 閉じる -->
    <sys:String x:Key="RwX.051">Close</sys:String>
</ResourceDictionary>
