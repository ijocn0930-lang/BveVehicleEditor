<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- MotorNoiseForm.xaml.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 力行 -->
    <sys:String x:Key="Mn.001">Power</sys:String>
    <!-- ブレーキ -->
    <sys:String x:Key="Mn.002">Brake</sys:String>
    <!-- 音量 -->
    <sys:String x:Key="Mn.003">Volume</sys:String>
    <!-- Volume：モーター音の音量の表（1 が元の音量。0～1） -->
    <sys:String x:Key="Mn.004">Volume: motor noise volume table (1 is the original volume; 0 to 1)</sys:String>
    <!-- 音量（1 が元の音量） -->
    <sys:String x:Key="Mn.005">Volume (1 is the original volume)</sys:String>
    <!-- ピッチ -->
    <sys:String x:Key="Mn.006">Pitch</sys:String>
    <!-- Frequency：モーター音のピッチの表（1 が元のピッチ） -->
    <sys:String x:Key="Mn.007">Frequency: motor noise pitch table (1 is the original pitch)</sys:String>
    <!-- ピッチ（1 が元のピッチ） -->
    <sys:String x:Key="Mn.008">Pitch (1 is the original pitch)</sys:String>
    <!-- 参照 -->
    <sys:String x:Key="Mn.009">Browse</sys:String>
    <!-- 開く -->
    <sys:String x:Key="Mn.010">Open</sys:String>
    <!-- 表のファイルを別のウィンドウで、表の形で見ます -->
    <sys:String x:Key="Mn.011">Shows the table file as a table in another window</sys:String>
    <!-- 書かれていません -->
    <sys:String x:Key="Mn.012">not written</sys:String>
    <!-- モーター音のファイルを読み込めていないので、表のファイルを探せません（参照ボタンも使えません）。 -->
    <sys:String x:Key="Mn.013">The motor noise file is not loaded, so the table files cannot be found (the Browse buttons cannot be used either).</sys:String>
    <!-- ファイルが見つかりません -->
    <sys:String x:Key="Mn.014">file not found</sys:String>
    <!-- 表のファイル (*.csv;*.txt)|*.csv;*.txt|すべてのファイル (*.*)|*.* -->
    <sys:String x:Key="Mn.015">Table files (*.csv;*.txt)|*.csv;*.txt|All files (*.*)|*.*</sys:String>
    <!-- [{0}] {1} の表のファイルを選択してください -->
    <sys:String x:Key="Mn.016">Select the table file for [{0}] {1}</sys:String>
    <!-- このファイルは MotorNoise.txt に書けません。  {0} {1} -->
    <sys:String x:Key="Mn.017">This file cannot be written in MotorNoise.txt.

{0}
{1}</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Mn.018">Confirm</sys:String>
    <!-- [{0}] {1}・モーター音の{2} -->
    <sys:String x:Key="Mn.019">[{0}] {1} - motor noise {2}</sys:String>
    <!-- 速度 (km/h) -->
    <sys:String x:Key="Mn.020">Speed (km/h)</sys:String>
    <!-- 音 -->
    <sys:String x:Key="Mn.021">Sound</sys:String>
    <!-- 表のファイルを開けませんでした。  {0} -->
    <sys:String x:Key="Mn.022">The table file could not be opened.

{0}</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Mn.023">Confirm</sys:String>
</ResourceDictionary>
