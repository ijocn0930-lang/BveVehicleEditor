<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- PanelForm.xaml の文（日本語）。英語は PfX.en.xaml -->
    <sys:String x:Key="PfX.001">編集するセクションを選んでください。欄で変えると、選んだセクションの中だけ下のテキストが書き換わります（テキストをクリックして Ctrl+Z で戻せます）。「そのほかの項目」は今は表示だけです。</sys:String>
    <sys:String x:Key="PfX.002">セクション</sys:String>
    <sys:String x:Key="PfX.003">セクションを足す ▼</sys:String>
    <sys:String x:Key="PfX.004">このセクションを消す</sys:String>
    <sys:String x:Key="PfX.005">BveTs Instrument Panel 2.01 に書き直す</sys:String>
    <sys:String x:Key="PfX.006">計器に共通の項目</sys:String>
    <sys:String x:Key="PfX.007">表示する状態量</sys:String>
    <sys:String x:Key="PfX.008">Subject：表示する状態量（kmph・bc・ats0 など）</sys:String>
    <sys:String x:Key="PfX.009">一覧から選ぶ ▼</sys:String>
    <sys:String x:Key="PfX.010">位置</sys:String>
    <sys:String x:Key="PfX.011">Location：パネル画像の座標（x, y）</sys:String>
    <sys:String x:Key="PfX.012">昼間の画像</sys:String>
    <sys:String x:Key="PfX.013">DaytimeImage：昼間の画像（このファイルからの相対パス）</sys:String>
    <sys:String x:Key="PfX.014">夜間の画像</sys:String>
    <sys:String x:Key="PfX.015">NighttimeImage：夜間の画像（このファイルからの相対パス）</sys:String>
    <sys:String x:Key="PfX.016">透過色</sys:String>
    <sys:String x:Key="PfX.017">TransparentColor：透過色。6 桁の 16 進数のカラーコード（例：FF0000）</sys:String>
    <sys:String x:Key="PfX.018">描画順序</sys:String>
    <sys:String x:Key="PfX.019">Layer：この画像の描画順序。値が大きいほど手前。ベース画像（[This] の画像）は 0</sys:String>
    <sys:String x:Key="PfX.020">計器ごとの項目</sys:String>
    <sys:String x:Key="PfX.021">色</sys:String>
    <sys:String x:Key="PfX.022">Color：6 桁の 16 進数のカラーコード（例：FF0000）。[Needle] は面の色、[DigitalGauge] は LED 消灯の色</sys:String>
    <sys:String x:Key="PfX.023">針の画像の回転中心</sys:String>
    <sys:String x:Key="PfX.024">Origin：針の画像における回転中心（x, y）</sys:String>
    <sys:String x:Key="PfX.025">半径</sys:String>
    <sys:String x:Key="PfX.026">Radius：[Needle] は針の半径、[DigitalGauge] はゲージの半径</sys:String>
    <sys:String x:Key="PfX.027">最小の角度（度）</sys:String>
    <sys:String x:Key="PfX.028">InitialAngle：角度 [deg]。時計の 12 時の方向が 0 で、時計回りがプラス</sys:String>
    <sys:String x:Key="PfX.029">最大の角度（度）</sys:String>
    <sys:String x:Key="PfX.030">LastAngle：角度 [deg]。1 周以上回る針は、InitialAngle + 360 の値にする</sys:String>
    <sys:String x:Key="PfX.031">最小値</sys:String>
    <sys:String x:Key="PfX.032">Minimum：最小値</sys:String>
    <sys:String x:Key="PfX.033">最大値</sys:String>
    <sys:String x:Key="PfX.034">Maximum：最大値</sys:String>
    <sys:String x:Key="PfX.035">傾き（X, Y 度）</sys:String>
    <sys:String x:Key="PfX.036">Tilt：垂直面に対する回転面（表示面）の角度。angleX は X 軸まわり（上向きがプラス）、angleY は Y 軸まわり（左向きがプラス）</sys:String>
    <sys:String x:Key="PfX.037">可動範囲の制限</sys:String>
    <sys:String x:Key="PfX.038">StopPin：針の動く範囲を Minimum と Maximum の間に止めるなら True</sys:String>
    <sys:String x:Key="PfX.039">針の固有角振動数</sys:String>
    <sys:String x:Key="PfX.040">NaturalFreq：高くすると震えやすいが、高くしすぎると針が消える</sys:String>
    <sys:String x:Key="PfX.041">針の減衰比</sys:String>
    <sys:String x:Key="PfX.042">DampingRatio：高くするとすぐに収まる</sys:String>
    <sys:String x:Key="PfX.043">分解能</sys:String>
    <sys:String x:Key="PfX.044">Step：分解能</sys:String>
    <sys:String x:Key="PfX.045">1 コマの高さ</sys:String>
    <sys:String x:Key="PfX.046">Interval：数字配列画像の 1 コマの高さ</sys:String>
    <sys:String x:Key="PfX.047">（セクションを選んでください）</sys:String>
    <sys:String x:Key="PfX.048">このセクションには何も書かれていません。</sys:String>
    <sys:String x:Key="PfX.049">[This] 表示領域とベース画像</sys:String>
    <sys:String x:Key="PfX.050">解像度</sys:String>
    <sys:String x:Key="PfX.051">Resolution：ズーム 1 倍のときの X 解像度</sys:String>
    <sys:String x:Key="PfX.052">左の限界</sys:String>
    <sys:String x:Key="PfX.053">Left：視点移動で表示できる限界の座標（左）</sys:String>
    <sys:String x:Key="PfX.054">上の限界</sys:String>
    <sys:String x:Key="PfX.055">Top：視点移動で表示できる限界の座標（上）</sys:String>
    <sys:String x:Key="PfX.056">右の限界</sys:String>
    <sys:String x:Key="PfX.057">Right：視点移動で表示できる限界の座標（右）</sys:String>
    <sys:String x:Key="PfX.058">下の限界</sys:String>
    <sys:String x:Key="PfX.059">Bottom：視点移動で表示できる限界の座標（下）</sys:String>
    <sys:String x:Key="PfX.060">昼間の画像</sys:String>
    <sys:String x:Key="PfX.061">DaytimeImage：昼間のパネル画像（このファイルからの相対パス）</sys:String>
    <sys:String x:Key="PfX.062">夜間の画像</sys:String>
    <sys:String x:Key="PfX.063">NighttimeImage：夜間のパネル画像（このファイルからの相対パス）</sys:String>
    <sys:String x:Key="PfX.064">透過色</sys:String>
    <sys:String x:Key="PfX.065">TransparentColor：透過色。6 桁の 16 進数のカラーコード（例：FF0000）</sys:String>
    <sys:String x:Key="PfX.066">画面の中心</sys:String>
    <sys:String x:Key="PfX.067">Center：既定の視点で画面の中心になる座標（x, y）</sys:String>
    <sys:String x:Key="PfX.068">消失点</sys:String>
    <sys:String x:Key="PfX.069">Origin：消失点の座標（x, y）</sys:String>
    <sys:String x:Key="PfX.070">パースの強さ</sys:String>
    <sys:String x:Key="PfX.071">Perspective：Tilt を設定した計器のパース（遠近感）の強さ。値が大きいほどパースは弱くなる。Tilt のない計器には効果なし</sys:String>
</ResourceDictionary>
