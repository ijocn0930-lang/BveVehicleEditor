<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- ResistanceCalculator.Brake.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 限流値は 0 より大きくしてください。 -->
    <sys:String x:Key="RCB.001">The current limit must be greater than 0.</sys:String>
    <!-- 限流値のときの力は 0 より大きくしてください。 -->
    <sys:String x:Key="RCB.002">The force at the current limit must be greater than 0.</sys:String>
    <!-- 段の数は 1～{0} にしてください。 -->
    <sys:String x:Key="RCB.003">The number of steps must be 1 to {0}.</sys:String>
    <!-- いちばん速い段と最後の段の速度は 0 より大きくしてください。 -->
    <sys:String x:Key="RCB.004">The speeds of the fastest step and the last step must be greater than 0.</sys:String>
    <!-- 最後の段の速度は、いちばん速い段の速度以下にしてください（ブレーキは速い速度から段が進みます）。 -->
    <sys:String x:Key="RCB.005">The speed of the last step must not exceed the speed of the fastest step (brake steps advance from high speed).</sys:String>
    <!-- 段ごとの切り替わる速度の数（{0} 個）を、段の数（{1}）と同じにするか、空にしてください。 -->
    <sys:String x:Key="RCB.006">Make the number of switching speeds ({0}) equal to the number of steps ({1}), or leave it empty.</sys:String>
    <!-- 段ごとの切り替わる速度は、0 より大きく、だんだん小さくなる（同じでもよい）並びにしてください（速い順）。 -->
    <sys:String x:Key="RCB.007">The switching speeds must be greater than 0 and decrease step by step (equal values are allowed; fastest first).</sys:String>
    <!-- 段ごとの限流値はマイナスにできません。 -->
    <sys:String x:Key="RCB.008">The current limit of each step cannot be negative.</sys:String>
    <!-- 飽和の強さ s は 0 より大きくしてください（ふつう 0.2～5）。 -->
    <sys:String x:Key="RCB.009">Saturation s must be greater than 0 (usually 0.2 to 5).</sys:String>
    <!-- 限流値より上の飽和の強さはマイナスにできません（0 なら s と同じ）。 -->
    <sys:String x:Key="RCB.010">Saturation above the current limit cannot be negative (0 means the same as s).</sys:String>
    <!-- 速度による電圧の下がり b はマイナスにできません（ふつう 0～0.003）。 -->
    <sys:String x:Key="RCB.011">Voltage drop by speed b cannot be negative (usually 0 to 0.003).</sys:String>
    <!-- 速度による電圧の下がり b が大きすぎて、速い段で電流が流れません。b を小さくしてください。 -->
    <sys:String x:Key="RCB.012">Voltage drop by speed b is too large, so no current flows in the fast steps. Make b smaller.</sys:String>
    <!-- 最高速度は 0 より大きくしてください。 -->
    <sys:String x:Key="RCB.013">The maximum speed must be greater than 0.</sys:String>
    <!-- 速度の刻みは 0 より大きくしてください。 -->
    <sys:String x:Key="RCB.014">The speed step must be greater than 0.</sys:String>
</ResourceDictionary>
