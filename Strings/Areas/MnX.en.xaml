<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- MotorNoiseForm.xaml の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 音量・ピッチの表のファイル（CSV）を「参照」で選ぶと、下のテキストが書き換わります（テキストをクリックして Ctrl+Z で戻せます）。パスは MotorNoise.txt からの相対パスです。「開く」で、表のファイルを別のウィンドウで表の形で見られます（列は Motor0.wav・Motor1.wav … の音の番号です）。 -->
    <sys:String x:Key="MnX.001">When you choose a volume or pitch table file (CSV) with "Browse", the text below is rewritten (click the text and press Ctrl+Z to undo). Paths are relative to MotorNoise.txt. "Open" shows the table file as a table in another window (the columns are the sound numbers of Motor0.wav, Motor1.wav, …).</sys:String>
    <!-- [Power] 力行のモーター音 -->
    <sys:String x:Key="MnX.002">[Power] Motor noise when powering</sys:String>
    <!-- [Brake] ブレーキのモーター音 -->
    <sys:String x:Key="MnX.003">[Brake] Motor noise when braking</sys:String>
</ResourceDictionary>
