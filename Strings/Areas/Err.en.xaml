<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- ErrorText.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 原因の分からないエラーが起きました。 -->
    <sys:String x:Key="Err.001">An error of unknown cause occurred.</sys:String>
    <!-- ファイルが見つかりません。{0} -->
    <sys:String x:Key="Err.002">The file was not found. {0}</sys:String>
    <!-- フォルダーが見つかりません。フォルダーの名前を変えたり、消したりしていないか確かめてください。 -->
    <sys:String x:Key="Err.003">The folder was not found. Check that the folder has not been renamed or deleted.</sys:String>
    <!-- ドライブが見つかりません。USB メモリーや外付けのディスクがつながっているか確かめてください。 -->
    <sys:String x:Key="Err.004">The drive was not found. Check that the USB memory or external disk is connected.</sys:String>
    <!-- パスが長すぎます。フォルダーやファイルの名前を短くしてください。 -->
    <sys:String x:Key="Err.005">The path is too long. Please shorten the folder or file names.</sys:String>
    <!-- ファイルを読み書きする権限がありません。読み取り専用のファイルか、管理者の権限が必要な場所（Program Files など）かもしれません。 -->
    <sys:String x:Key="Err.006">You do not have permission to read or write the file. The file may be read-only, or the location may require administrator rights (such as Program Files).</sys:String>
    <!-- パスとして読み取れません。使えない文字が入っていないか確かめてください。 -->
    <sys:String x:Key="Err.007">It cannot be read as a path. Check that it does not contain invalid characters.</sys:String>
    <!-- メモリーが足りません。ほかのアプリを閉じてから、もう一度試してください。 -->
    <sys:String x:Key="Err.008">There is not enough memory. Close other apps and try again.</sys:String>
    <!-- 思わぬエラーが起きました（種類：{0}）。 -->
    <sys:String x:Key="Err.009">An unexpected error occurred (type: {0}).</sys:String>
    <!-- ほかのアプリがこのファイルを使っています。そのアプリでファイルを閉じてから、もう一度試してください。 -->
    <sys:String x:Key="Err.010">Another app is using this file. Close the file in that app and try again.</sys:String>
    <!-- ディスクの空きが足りません。いらないファイルを消してから、もう一度試してください。 -->
    <sys:String x:Key="Err.011">There is not enough free disk space. Delete unnecessary files and try again.</sys:String>
    <!-- 書き込みが禁止されているディスクです。 -->
    <sys:String x:Key="Err.012">The disk is write-protected.</sys:String>
    <!-- ドライブの準備ができていません。USB メモリーや外付けのディスクがつながっているか確かめてください。 -->
    <sys:String x:Key="Err.013">The drive is not ready. Check that the USB memory or external disk is connected.</sys:String>
    <!-- ファイルの読み書きでエラーが起きました（エラー番号 {0}）。 -->
    <sys:String x:Key="Err.014">An error occurred while reading or writing the file (error number {0}).</sys:String>
</ResourceDictionary>
