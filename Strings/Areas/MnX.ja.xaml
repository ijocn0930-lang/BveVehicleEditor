<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- MotorNoiseForm.xaml の文（日本語）。英語は MnX.en.xaml -->
    <sys:String x:Key="MnX.001">音量・ピッチの表のファイル（CSV）を「参照」で選ぶと、下のテキストが書き換わります（テキストをクリックして Ctrl+Z で戻せます）。パスは MotorNoise.txt からの相対パスです。「開く」で、表のファイルを別のウィンドウで表の形で見られます（列は Motor0.wav・Motor1.wav … の音の番号です）。</sys:String>
    <sys:String x:Key="MnX.002">[Power] 力行のモーター音</sys:String>
    <sys:String x:Key="MnX.003">[Brake] ブレーキのモーター音</sys:String>
</ResourceDictionary>
