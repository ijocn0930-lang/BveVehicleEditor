<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- TableWindow.xaml.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 列（{0}）を足す -->
    <sys:String x:Key="Tw.002">Add column ({0})</sys:String>
    <!-- {0} で書けない文字があります（{1}）。その文字を消してから保存してください。 -->
    <sys:String x:Key="Tw.004">There are characters that cannot be written in {0} ({1}). Delete them before saving.</sys:String>
    <!-- {0} 行目の{1}「{2}」 -->
    <sys:String x:Key="Tw.005">{1} "{2}" on line {0}</sys:String>
    <!-- {0} 行目（{1}「{2}」） -->
    <sys:String x:Key="Tw.006">line {0} ({1} "{2}")</sys:String>
    <!-- {0} 行目 -->
    <sys:String x:Key="Tw.007">line {0}</sys:String>
    <!-- {0}　ほか {1} 行 -->
    <sys:String x:Key="Tw.008">{0}  and {1} more</sys:String>
    <!-- 行 -->
    <sys:String x:Key="Tw.009">Row</sys:String>
    <!-- 単位・説明 -->
    <sys:String x:Key="Tw.010">Unit / description</sys:String>
    <!-- ヘッダー：{0}　文字コード：{1}　データの行：{2}　{3}の列：{4} -->
    <sys:String x:Key="Tw.011">Header: {0}   Encoding: {1}   Data rows: {2}   {3} columns: {4}</sys:String>
    <!-- 　ほか {0} か所 -->
    <sys:String x:Key="Tw.012">  and {0} more</sys:String>
    <!-- 数字でないセル：{0}{1} -->
    <sys:String x:Key="Tw.013">Cells that are not numbers: {0}{1}</sys:String>
    <!-- 値が空の行（2 列目から全部空。BVE でエラーになります）：{0} -->
    <sys:String x:Key="Tw.014">Rows with empty values (all empty from column 2; BVE reports an error): {0}</sys:String>
    <!-- {0}が空の行（値だけが入っています）：{1} -->
    <sys:String x:Key="Tw.015">Rows with empty {0} (only values are written): {1}</sys:String>
    <!-- {0} 行目「{1}」 -->
    <sys:String x:Key="Tw.016">line {0} "{1}"</sys:String>
    <!-- 一覧にない項目名（BVE でエラーになります）：{0} -->
    <sys:String x:Key="Tw.017">Item names not in the list (BVE reports an error): {0}</sys:String>
    <!-- {0}（{1} 行目） -->
    <sys:String x:Key="Tw.018">{0} (lines {1})</sys:String>
    <!-- 同じ項目名が 2 回以上あります：{0} -->
    <sys:String x:Key="Tw.019">Item names written twice or more: {0}</sys:String>
    <!-- {0} は {1:0.00} からの項目です -->
    <sys:String x:Key="Tw.020">{0} is an item from {1:0.00}</sys:String>
    <!-- {0}（ヘッダーは {1:0.00}） -->
    <sys:String x:Key="Tw.021">{0} (the header is {1:0.00})</sys:String>
    <!-- 書かれていない項目：{0}（「足りない項目を足す」で足せます） -->
    <sys:String x:Key="Tw.022">Items not written: {0} (you can add them with "Add missing items")</sys:String>
    <!-- 次の項目を、最後のデータの行の下に足しますか？  {0}  値はどのノッチも仮に 0 にします。足したあとで直してください。 保存するまでファイルは変わりません。 -->
    <sys:String x:Key="Tw.023">Add the following items below the last data row?

{0}

The values of every notch are 0 for now. Please fix them afterwards.
The file does not change until you save.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Tw.024">Confirm</sys:String>
    <!-- 消す行のセルを選んでから押してください。 -->
    <sys:String x:Key="Tw.025">Select cells in the rows to delete first.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Tw.026">Confirm</sys:String>
    <!-- ・ -->
    <sys:String x:Key="Tw.027">,</sys:String>
    <!--  ほか -->
    <sys:String x:Key="Tw.028"> and more</sys:String>
    <!-- {0} 行（{1}{2} 行目）を消しますか？  保存するまでファイルは変わりません。保存せずに閉じれば元に戻ります。 -->
    <sys:String x:Key="Tw.029">Delete {0} row(s) (lines {1}{2})?

The file does not change until you save. Closing without saving restores it.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Tw.030">Confirm</sys:String>
    <!-- 消す列（{0}）のセルを選んでから押してください。左の「行」と 1 列目は消せません。 -->
    <sys:String x:Key="Tw.031">Select cells in the columns ({0}) to delete first. The "Row" column and the first column cannot be deleted.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Tw.032">Confirm</sys:String>
    <!-- {0} の列を消しますか？ すべての行のこの列の値が消え、右の列が左へ詰まります。  保存するまでファイルは変わりません。保存せずに閉じれば元に戻ります。 -->
    <sys:String x:Key="Tw.033">Delete the {0} column?
The values in this column of all rows are deleted and the columns on the right move left.

The file does not change until you save. Closing without saving restores it.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Tw.034">Confirm</sys:String>
    <!-- 保存できませんでした。  {0} -->
    <sys:String x:Key="Tw.035">The file could not be saved.

{0}</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Tw.036">Confirm</sys:String>
    <!-- 保存しました。  {0} -->
    <sys:String x:Key="Tw.037">Saved.

{0}</sys:String>
    <!-- 保存 -->
    <sys:String x:Key="Tw.038">Save</sys:String>
    <!-- 「{0}」は保存していません。保存してから閉じますか？  はい：保存して閉じる いいえ：保存せずに閉じる キャンセル：閉じない -->
    <sys:String x:Key="Tw.039">"{0}" has not been saved. Save before closing?

Yes: save and close
No: close without saving
Cancel: do not close</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Tw.040">Confirm</sys:String>
</ResourceDictionary>
