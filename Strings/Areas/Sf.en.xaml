<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- SoundForm.xaml.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 走行音（車輪の転動音） -->
    <sys:String x:Key="Sf.001">Running sound (wheel rolling)</sys:String>
    <!-- 曲線のきしり音 -->
    <sys:String x:Key="Sf.002">Flange squeal on curves</sys:String>
    <!-- モーター音（音量・ピッチはモーター音のタブの表） -->
    <sys:String x:Key="Sf.003">Motor noise (volume and pitch are in the tables on the Motor Noise tab)</sys:String>
    <!-- 継ぎ目・分岐器の音（速度に応じて 1 回） -->
    <sys:String x:Key="Sf.004">Joint and turnout sounds (played once depending on speed)</sys:String>
    <!-- ブレーキの圧力が変わる音 -->
    <sys:String x:Key="Sf.005">Brake pressure change sounds</sys:String>
    <!-- ブレーキシリンダーの緩解音 -->
    <sys:String x:Key="Sf.006">Brake cylinder release</sys:String>
    <!-- ブレーキシリンダーが完全に緩解する音 -->
    <sys:String x:Key="Sf.007">Brake cylinder full release</sys:String>
    <!-- 高い圧力からの緩解音（なければ BcRelease） -->
    <sys:String x:Key="Sf.008">Release from high pressure (BcRelease if omitted)</sys:String>
    <!-- ブレーキ管の急減圧音 -->
    <sys:String x:Key="Sf.009">Brake pipe emergency exhaust</sys:String>
    <!-- ブレーキ管の減圧音（自動空気ブレーキ） -->
    <sys:String x:Key="Sf.010">Brake pipe reduction (automatic air brake)</sys:String>
    <!-- 空気圧縮機 -->
    <sys:String x:Key="Sf.011">Air compressor</sys:String>
    <!-- 起動 5 秒間の音 -->
    <sys:String x:Key="Sf.012">Sound for the first 5 seconds of starting</sys:String>
    <!-- 作動中の音 -->
    <sys:String x:Key="Sf.013">Sound while running</sys:String>
    <!-- 停止する音 -->
    <sys:String x:Key="Sf.014">Sound when stopping</sys:String>
    <!-- 空気ばね -->
    <sys:String x:Key="Sf.015">Air springs</sys:String>
    <!-- 左側の排気音 -->
    <sys:String x:Key="Sf.016">Left exhaust</sys:String>
    <!-- 右側の排気音 -->
    <sys:String x:Key="Sf.017">Right exhaust</sys:String>
    <!-- 左側の給気音 -->
    <sys:String x:Key="Sf.018">Left intake</sys:String>
    <!-- 右側の給気音 -->
    <sys:String x:Key="Sf.019">Right intake</sys:String>
    <!-- 断流器 -->
    <sys:String x:Key="Sf.020">Breaker</sys:String>
    <!-- 回路を閉じる音 -->
    <sys:String x:Key="Sf.021">Circuit closing</sys:String>
    <!-- 回路を開く音 -->
    <sys:String x:Key="Sf.022">Circuit opening</sys:String>
    <!-- 警笛 -->
    <sys:String x:Key="Sf.023">Horn</sys:String>
    <!-- 警笛 1（キーを押した時） -->
    <sys:String x:Key="Sf.024">Horn 1 (when the key is pressed)</sys:String>
    <!-- 警笛 1 の余韻（キーを離した時） -->
    <sys:String x:Key="Sf.025">Horn 1 tail (when the key is released)</sys:String>
    <!-- 警笛 2（キーを押した時） -->
    <sys:String x:Key="Sf.026">Horn 2 (when the key is pressed)</sys:String>
    <!-- 警笛 2 の余韻（キーを離した時） -->
    <sys:String x:Key="Sf.027">Horn 2 tail (when the key is released)</sys:String>
    <!-- ミュージックホーン -->
    <sys:String x:Key="Sf.028">Music horn</sys:String>
    <!-- 客室ドア -->
    <sys:String x:Key="Sf.029">Passenger doors</sys:String>
    <!-- 左側のドアが開く音 -->
    <sys:String x:Key="Sf.030">Left doors opening</sys:String>
    <!-- 右側のドアが開く音 -->
    <sys:String x:Key="Sf.031">Right doors opening</sys:String>
    <!-- 左側のドアが閉まる音 -->
    <sys:String x:Key="Sf.032">Left doors closing</sys:String>
    <!-- 右側のドアが閉まる音 -->
    <sys:String x:Key="Sf.033">Right doors closing</sys:String>
    <!-- ATS プラグインが鳴らす音（0～255） -->
    <sys:String x:Key="Sf.034">Sounds played by the ATS plugin (0 to 255)</sys:String>
    <!-- 車掌からの合図 -->
    <sys:String x:Key="Sf.035">Signals from the conductor</sys:String>
    <!-- 「停止位置直せ」の合図 -->
    <sys:String x:Key="Sf.036">"Correct the stop position" signal</sys:String>
    <!-- 運転士知らせ灯 -->
    <sys:String x:Key="Sf.037">Pilot lamp</sys:String>
    <!-- 点灯する音 -->
    <sys:String x:Key="Sf.038">Lighting</sys:String>
    <!-- 滅灯する音 -->
    <sys:String x:Key="Sf.039">Going out</sys:String>
    <!-- ブレーキハンドルの操作音 -->
    <sys:String x:Key="Sf.040">Brake handle sounds</sys:String>
    <!-- 込める方向にゆっくり -->
    <sys:String x:Key="Sf.041">Slowly toward application</sys:String>
    <!-- 込める方向にすばやく（なければ Apply） -->
    <sys:String x:Key="Sf.042">Quickly toward application (Apply if omitted)</sys:String>
    <!-- 緩める方向にゆっくり -->
    <sys:String x:Key="Sf.043">Slowly toward release</sys:String>
    <!-- 緩める方向にすばやく（なければ Release） -->
    <sys:String x:Key="Sf.044">Quickly toward release (Release if omitted)</sys:String>
    <!-- 緩め位置にしたとき -->
    <sys:String x:Key="Sf.045">To the release position</sys:String>
    <!-- 非常位置にしたとき -->
    <sys:String x:Key="Sf.046">To the emergency position</sys:String>
    <!-- 主ハンドルの操作音 -->
    <sys:String x:Key="Sf.047">Master controller sounds</sys:String>
    <!-- ノッチをゆっくり上げたとき -->
    <sys:String x:Key="Sf.048">Notch up slowly</sys:String>
    <!-- ノッチをすばやく上げたとき（なければ Up） -->
    <sys:String x:Key="Sf.049">Notch up quickly (Up if omitted)</sys:String>
    <!-- ノッチをゆっくり下げたとき -->
    <sys:String x:Key="Sf.050">Notch down slowly</sys:String>
    <!-- ノッチをすばやく下げたとき（なければ Down） -->
    <sys:String x:Key="Sf.051">Notch down quickly (Down if omitted)</sys:String>
    <!-- フルノッチにしたとき -->
    <sys:String x:Key="Sf.052">To full notch</sys:String>
    <!-- 切位置にしたとき -->
    <sys:String x:Key="Sf.053">To the off position</sys:String>
    <!-- レバーサーの操作音 -->
    <sys:String x:Key="Sf.054">Reverser sounds</sys:String>
    <!-- 前位置か後位置にしたとき -->
    <sys:String x:Key="Sf.055">To forward or reverse</sys:String>
    <!-- 切位置にしたとき -->
    <sys:String x:Key="Sf.056">To the off position</sys:String>
    <!-- その他 -->
    <sys:String x:Key="Sf.057">Others</sys:String>
    <!-- いつも鳴り続ける音 -->
    <sys:String x:Key="Sf.058">Sound that always plays continuously</sys:String>
    <!-- 制輪子のきしり音 -->
    <sys:String x:Key="Sf.059">Brake shoe squeal</sys:String>
    <!-- （{0} 個） -->
    <sys:String x:Key="Sf.060"> ({0})</sys:String>
    <!-- （なし） -->
    <sys:String x:Key="Sf.061"> (none)</sys:String>
    <!-- サウンドのファイルを読み込めていないので、音のファイルを探せません（参照ボタンも使えません）。 -->
    <sys:String x:Key="Sf.062">The sound file is not loaded, so the sound files cannot be found (the Browse buttons cannot be used either).</sys:String>
    <!-- まだ書かれていません。下の「番号」に番号を入れて「この番号で音を選ぶ…」を押すと、「番号 = パス」の行を足します（セクションがなければセクションごと足します）。 -->
    <sys:String x:Key="Sf.063">Not written yet. Enter a number in "Number" below and press "Choose a sound for this number…" to add a "number = path" line (the section is added too if missing).</sys:String>
    <!-- 番号は 0 以上の整数です{0}。下の「番号」で足し、「消す」で行を消せます。 -->
    <sys:String x:Key="Sf.064">Numbers are whole numbers of 0 or more{0}. Add one with "Number" below, and delete lines with "Delete".</sys:String>
    <!-- 番号 {0} -->
    <sys:String x:Key="Sf.065">Number {0}</sys:String>
    <!-- このセクションはまだ書かれていません。「参照」で選ぶと、セクションごと足します。 -->
    <sys:String x:Key="Sf.066">This section is not written yet. Choosing a file with "Browse" adds the section too.</sys:String>
    <!-- {0}（書かれていません） -->
    <sys:String x:Key="Sf.067">{0} (not written)</sys:String>
    <!-- 参照 -->
    <sys:String x:Key="Sf.068">Browse</sys:String>
    <!-- 消す -->
    <sys:String x:Key="Sf.069">Delete</sys:String>
    <!-- この行を、確認してから下のテキストから消します（Ctrl+Z で戻せます） -->
    <sys:String x:Key="Sf.070">Deletes this line from the text below after confirming (Ctrl+Z undoes it)</sys:String>
    <!-- ほか {0} 件 -->
    <sys:String x:Key="Sf.071">{0} more</sys:String>
    <!-- {0} 行目：[{1}] は公式の一覧にないセクションです（中の音は使われないかもしれません） -->
    <sys:String x:Key="Sf.072">Line {0}: [{1}] is not an official section (the sounds in it may not be used)</sys:String>
    <!-- {0} 行目：[{1}] は {2} 行目の [{3}] と同じセクションです（空白の入れ方や古い名前など、書き方だけが違います）。1 つにまとめてください -->
    <sys:String x:Key="Sf.073">Line {0}: [{1}] is the same section as [{3}] on line {2} (only the spacing or the old name differs). Please merge them into one</sys:String>
    <!-- {0} 行目：[{1}] {2} は公式の一覧にないキーです（{3} のどれか） -->
    <sys:String x:Key="Sf.074">Line {0}: [{1}] {2} is not an official key (use one of {3})</sys:String>
    <!-- {0} 行目：[{1}] {2} … {3} -->
    <sys:String x:Key="Sf.075">Line {0}: [{1}] {2} … {3}</sys:String>
    <!-- {0} 行目：[{1}] {2} … キーは 0 以上の整数にしてください -->
    <sys:String x:Key="Sf.076">Line {0}: [{1}] {2} … the key must be a whole number of 0 or more</sys:String>
    <!-- {0} 行目：[Ats] {1} … ATS の番号は 0～{2} です -->
    <sys:String x:Key="Sf.077">Line {0}: [Ats] {1} … ATS numbers are 0 to {2}</sys:String>
    <!-- BveTs Vehicle Sound {0} から使えます（今のヘッダーは {1}） -->
    <sys:String x:Key="Sf.078">available from BveTs Vehicle Sound {0} (the current header is {1})</sys:String>
    <!--  （このファイルは Shift_JIS なので、文字コードの指定 :shift_jis も付けます） -->
    <sys:String x:Key="Sf.079">
(This file is Shift_JIS, so the encoding :shift_jis is also added.)</sys:String>
    <!-- 1 行目のヘッダー「Version 1.0」を「{0}」に書き換えますか？{1}  中身（セクションとキー）は変えません。[Switch] などの古い名前は、書き直したあとに警告します。 テキストをクリックして Ctrl+Z で戻せます。保存するまでファイルは変わりません。 -->
    <sys:String x:Key="Sf.080">Change the header "Version 1.0" on line 1 to "{0}"?{1}

The contents (sections and keys) are not changed. Old names such as [Switch] are reported after the conversion.
Click the text and press Ctrl+Z to undo. The file does not change until you save.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Sf.081">Confirm</sys:String>
    <!-- ファイルが見つかりません -->
    <sys:String x:Key="Sf.082">file not found</sys:String>
    <!-- [{0}] {1} の音のファイルを選択してください -->
    <sys:String x:Key="Sf.083">Select the sound file for [{0}] {1}</sys:String>
    <!-- この音のファイルを鳴らせませんでした。  {0}  {1} -->
    <sys:String x:Key="Sf.084">This sound file could not be played.

{0}

{1}</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Sf.085">Confirm</sys:String>
    <!-- 鳴らしている音を止めます -->
    <sys:String x:Key="Sf.086">Stops the sound that is playing</sys:String>
    <!-- 音を鳴らして確かめます（もう一度押すと止めます。ほかの行の ▶ を押すと、そちらに替わります） -->
    <sys:String x:Key="Sf.087">Plays the sound to check it (press again to stop; pressing ▶ on another line switches to that sound)</sys:String>
    <!-- この音のファイルを鳴らせませんでした。  {0}  {1} -->
    <sys:String x:Key="Sf.088">This sound file could not be played.

{0}

{1}</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Sf.089">Confirm</sys:String>
    <!-- ファイルは wav の形をしています。 -->
    <sys:String x:Key="Sf.090">The file is in wav format.</sys:String>
    <!-- ファイルの中身が wav の形ではありません。ファイルが壊れているか、名前だけ .wav の別の形式かもしれません。 -->
    <sys:String x:Key="Sf.091">The file contents are not in wav format. The file may be broken, or it may be another format with only the .wav name.</sys:String>
    <!-- ファイルを読めませんでした（ほかのアプリが使っている・消された、などが考えられます）。 -->
    <sys:String x:Key="Sf.092">The file could not be read (another app may be using it, or it may have been deleted).</sys:String>
    <!-- 音のファイル (*.wav)|*.wav|すべてのファイル (*.*)|*.* -->
    <sys:String x:Key="Sf.093">Sound files (*.wav)|*.wav|All files (*.*)|*.*</sys:String>
    <!-- このファイルは Sound.txt に書けません。  {0} {1} -->
    <sys:String x:Key="Sf.094">This file cannot be written in Sound.txt.

{0}
{1}</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Sf.095">Confirm</sys:String>
    <!-- 番号は 0 以上の整数で入れてください（「{0}」）。 -->
    <sys:String x:Key="Sf.096">Please enter a whole number of 0 or more ("{0}").</sys:String>
    <!-- ATS の番号は 0～{0} です（「{1}」）。 -->
    <sys:String x:Key="Sf.097">ATS numbers are 0 to {0} ("{1}").</sys:String>
    <!-- 番号 {0} はもう書かれています。その行の「参照」で選び直してください。 -->
    <sys:String x:Key="Sf.098">Number {0} is already written. Choose it again with "Browse" on that line.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Sf.099">Confirm</sys:String>
    <!-- [{0}] 番号 {1} の音のファイルを選択してください -->
    <sys:String x:Key="Sf.100">Select the sound file for [{0}] number {1}</sys:String>
    <!-- {0} 行目：{1} = {2} -->
    <sys:String x:Key="Sf.101">Line {0}: {1} = {2}</sys:String>
    <!-- [{0}] の次の行を消しますか？  {1}  音のファイル（wav）は消しません。テキストをクリックして Ctrl+Z で戻せます。 -->
    <sys:String x:Key="Sf.102">Delete the following lines in [{0}]?

{1}

The sound files (wav) are not deleted. Click the text and press Ctrl+Z to undo.</sys:String>
    <!-- 確認 -->
    <sys:String x:Key="Sf.103">Confirm</sys:String>
</ResourceDictionary>
