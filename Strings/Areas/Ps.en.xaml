<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xml:space="preserve">
    <!-- PanelSubjects.cs の文（英語）。各行の上のコメントは日本語の文 -->
    <!-- 常に True（ずっと表示する） -->
    <sys:String x:Key="Ps.001">Always True (always shown)</sys:String>
    <!-- 速度 [km/h] -->
    <sys:String x:Key="Ps.002">Speed [km/h]</sys:String>
    <!-- 速度 [km/h] の 1 の位 -->
    <sys:String x:Key="Ps.003">Ones digit of speed [km/h]</sys:String>
    <!-- 速度 [km/h] の 10 の位 -->
    <sys:String x:Key="Ps.004">Tens digit of speed [km/h]</sys:String>
    <!-- 速度 [km/h] の 100 の位 -->
    <sys:String x:Key="Ps.005">Hundreds digit of speed [km/h]</sys:String>
    <!-- ブレーキシリンダ圧力 [kPa] -->
    <sys:String x:Key="Ps.006">Brake cylinder pressure [kPa]</sys:String>
    <!-- ブレーキシリンダ圧力 [kPa] の 10 の位 -->
    <sys:String x:Key="Ps.007">Tens digit of brake cylinder pressure [kPa]</sys:String>
    <!-- ブレーキシリンダ圧力 [kPa] の 100 の位 -->
    <sys:String x:Key="Ps.008">Hundreds digit of brake cylinder pressure [kPa]</sys:String>
    <!-- 元空気溜め圧力 [kPa] -->
    <sys:String x:Key="Ps.009">Main reservoir pressure [kPa]</sys:String>
    <!-- 元空気溜め圧力 [kPa] の 10 の位 -->
    <sys:String x:Key="Ps.010">Tens digit of main reservoir pressure [kPa]</sys:String>
    <!-- 元空気溜め圧力 [kPa] の 100 の位 -->
    <sys:String x:Key="Ps.011">Hundreds digit of main reservoir pressure [kPa]</sys:String>
    <!-- 直通管圧力 [kPa] -->
    <sys:String x:Key="Ps.012">Straight air pipe pressure [kPa]</sys:String>
    <!-- ブレーキ管圧力 [kPa] -->
    <sys:String x:Key="Ps.013">Brake pipe pressure [kPa]</sys:String>
    <!-- 釣り合い空気溜め圧力 [kPa] -->
    <sys:String x:Key="Ps.014">Equalizing reservoir pressure [kPa]</sys:String>
    <!-- 電流 [A]（力行: +、ブレーキ: -） -->
    <sys:String x:Key="Ps.015">Current [A] (power: +, brake: -)</sys:String>
    <!-- 電流 [A]（力行もブレーキも +） -->
    <sys:String x:Key="Ps.016">Current [A] (+ for both power and brake)</sys:String>
    <!-- ドアの状態（全ドア閉: True、どこかのドアが開: False） -->
    <sys:String x:Key="Ps.017">Door state (all doors closed: True, any door open: False)</sys:String>
    <!-- 号車ごとの左側ドアの状態（開: True、閉: False。先頭車両が doorl0、2 両目が doorl1 …） -->
    <sys:String x:Key="Ps.018">Left door state for each car (open: True, closed: False; the first car is doorl0, the second doorl1 …)</sys:String>
    <!-- 号車ごとの右側ドアの状態（開: True、閉: False。先頭車両が doorr0、2 両目が doorr1 …） -->
    <sys:String x:Key="Ps.019">Right door state for each car (open: True, closed: False; the first car is doorr0, the second doorr1 …)</sys:String>
    <!-- 定速制御（ブレーキだけの制御を除く）の状態（制御中: True、停止: False） -->
    <sys:String x:Key="Ps.020">Constant speed control state (excluding brake-only control) (controlling: True, stopped: False)</sys:String>
    <!-- ATS プラグインから受け取った値（ats0 ～ ats255） -->
    <sys:String x:Key="Ps.021">Value received from the ATS plugin (ats0 to ats255)</sys:String>
    <!-- 力行ノッチ -->
    <sys:String x:Key="Ps.022">Power notch</sys:String>
    <!-- ブレーキノッチ -->
    <sys:String x:Key="Ps.023">Brake notch</sys:String>
    <!-- 時刻 [時] -->
    <sys:String x:Key="Ps.024">Time [hours]</sys:String>
    <!-- 時刻 [分] -->
    <sys:String x:Key="Ps.025">Time [minutes]</sys:String>
    <!-- 時刻 [秒] -->
    <sys:String x:Key="Ps.026">Time [seconds]</sys:String>
    <!-- 左側 -->
    <sys:String x:Key="Ps.027">left</sys:String>
    <!-- 右側 -->
    <sys:String x:Key="Ps.028">right</sys:String>
    <!-- {0} 両目の{1}ドアの状態（開: True、閉: False）（bool） -->
    <sys:String x:Key="Ps.029">State of the {1} doors of car {0} (open: True, closed: False) (bool)</sys:String>
    <!-- ATS プラグインから受け取った {0} 番の値（int） -->
    <sys:String x:Key="Ps.030">Value number {0} received from the ATS plugin (int)</sys:String>
    <!-- 表示する状態量（Subject）「{0}」：ATS の番号は 0 ～ 255 です。 -->
    <sys:String x:Key="Ps.031">Subject "{0}": ATS numbers are 0 to 255.</sys:String>
    <!-- 表示する状態量（Subject）「{0}」は、状態量の一覧にありません（書き間違いかもしれません）。 -->
    <sys:String x:Key="Ps.032">Subject "{0}" is not in the list of values (it may be a typo).</sys:String>
    <!-- 表示する状態量（Subject）「{0}」は、ブレーキ方式が電磁直通 [Smee] か自動空気 [Cl] のときだけ使えます。今のパラメーターのブレーキ方式は {1} です。 -->
    <sys:String x:Key="Ps.033">Subject "{0}" can be used only when the brake system is electromagnetic straight air [Smee] or automatic air [Cl]. The brake system in the current parameters is {1}.</sys:String>
</ResourceDictionary>
