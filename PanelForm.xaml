<UserControl x:Class="BveVehicleEditor.PanelForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- パネル構成ファイルの入力フォーム。上の欄でセクションを選び、その中身を出す -->
    <!-- [PilotLamp]・[Needle] などは同じ名前のセクションを何個でも書けるので、上の欄で1つ選ぶ -->
    <!-- 段階2：[This] は欄で書き込める。ほかのセクションはまだ表示だけ -->
    <UserControl.Resources>
        <!-- 左側の項目名 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <!-- チェックボックスの文字は、幅 480 の小さいウィンドウでも切れないよう折り返す -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Grid.IsSharedSizeScope="True">
        <TextBlock Text="{DynamicResource PfX.001}"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="2,0,0,4" TextWrapping="Wrap" />

        <!-- セクションを選ぶ欄 -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource PfX.002}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" x:Name="CmbSection" SelectionChanged="CmbSection_SelectionChanged" />
        </Grid>

        <!-- セクションを足す（最後に足して、そのセクションを選ぶ）・選んでいるセクションを消す（確認してから。Ctrl+Z で戻せる） -->
        <WrapPanel Margin="0,0,0,6" HorizontalAlignment="Right">
            <Button x:Name="BtnAddSection" Content="{DynamicResource PfX.003}" Margin="0,0,6,0" Click="BtnAddSection_Click" />
            <Button x:Name="BtnRemoveSection" Content="{DynamicResource PfX.004}" Click="BtnRemoveSection_Click" />
        </WrapPanel>

        <!-- [This] がない、などのファイル全体の警告（[This] がないと BVE で運転台が丸ごと見えなくなる） -->
        <TextBlock x:Name="TxtPanelWarnings" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />

        <!-- セクションが1つもない・古い形式、などの知らせ -->
        <TextBlock x:Name="TxtPanelNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <!-- 古い形式（Version 1.0）のときだけ出す。押すと、何を変えるか見せて確認してから 2.01 に書き直す（Ctrl+Z で戻せる） -->
        <Button x:Name="BtnUpgradeLegacy" Content="{DynamicResource PfX.005}" HorizontalAlignment="Left" Margin="0,0,0,6"
                Visibility="Collapsed" Click="BtnUpgradeLegacy_Click" />

        <!-- 計器（[PilotLamp]・[Needle]・[DigitalNumber]・[DigitalGauge]）を選んだときの共通の欄 -->
        <!-- [DigitalGauge] には画像と透過色がないので、その行は隠す -->
        <GroupBox x:Name="GrpInstrument" Header="{DynamicResource PfX.006}" Margin="0,0,0,6" Visibility="Collapsed">
            <StackPanel>
                <!-- バージョンで使えない項目・画像の大きさが 2 のべき乗でない、などのお知らせ（警告ではない） -->
                <TextBlock x:Name="TxtInstrumentNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <!-- 数字でない・x, y の形でない・色が 6 桁でない、などの警告 -->
                <TextBlock x:Name="TxtInstrumentWarnings" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource PfX.007}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,8,2"
                               ToolTip="{DynamicResource PfX.008}" />
                    <!-- 打って書くこともでき、右のボタンで一覧から選ぶこともできる。下に今の状態量の説明を出す -->
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TxtInstSubject" />
                        <Button Grid.Column="1" x:Name="BtnSubjectList" Content="{DynamicResource PfX.009}" Margin="6,2,0,2" Click="BtnSubjectList_Click" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="TxtSubjectDescription" TextWrapping="Wrap" Margin="2,0,0,2"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </Grid>

                    <TextBlock Grid.Row="1" x:Name="LblInstLocation" Text="{DynamicResource PfX.010}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.011}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtInstLocation" />

                    <TextBlock Grid.Row="2" x:Name="LblInstDaytimeImage" Text="{DynamicResource PfX.012}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.013}" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtInstDaytimeImage" />

                    <TextBlock Grid.Row="3" x:Name="LblInstNighttimeImage" Text="{DynamicResource PfX.014}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.015}" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtInstNighttimeImage" />

                    <TextBlock Grid.Row="4" x:Name="LblInstTransparentColor" Text="{DynamicResource PfX.016}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.017}" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtInstTransparentColor" />

                    <TextBlock Grid.Row="5" Text="{DynamicResource PfX.018}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.019}" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtInstLayer" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- 計器ごとの欄。計器の種類で使う行だけを出し、項目名も計器に合わせて変える（PanelForm.xaml.cs の ShowSpecificRows） -->
        <!-- [Needle]：色・回転中心・半径・角度・最小最大・Tilt・StopPin・固有角振動数・減衰比 -->
        <!-- [DigitalGauge]：色・半径・角度・最小最大・Tilt・分解能　[DigitalNumber]：1 コマの高さ -->
        <GroupBox x:Name="GrpSpecific" Header="{DynamicResource PfX.020}" Margin="0,0,0,6" Visibility="Collapsed">
            <StackPanel>
                <!-- バージョンで使えない項目・画像の大きさが 2 のべき乗でない、などのお知らせ（警告ではない） -->
                <TextBlock x:Name="TxtSpecificNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="TxtSpecificWarnings" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="LblSpColor" Text="{DynamicResource PfX.021}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.022}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtSpColor" />

                    <TextBlock Grid.Row="1" x:Name="LblSpOrigin" Text="{DynamicResource PfX.023}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.024}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSpOrigin" />

                    <TextBlock Grid.Row="2" x:Name="LblSpRadius" Text="{DynamicResource PfX.025}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.026}" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtSpRadius" />

                    <TextBlock Grid.Row="3" x:Name="LblSpInitialAngle" Text="{DynamicResource PfX.027}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.028}" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtSpInitialAngle" />

                    <TextBlock Grid.Row="4" x:Name="LblSpLastAngle" Text="{DynamicResource PfX.029}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.030}" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtSpLastAngle" />

                    <TextBlock Grid.Row="5" x:Name="LblSpMinimum" Text="{DynamicResource PfX.031}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.032}" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtSpMinimum" />

                    <TextBlock Grid.Row="6" x:Name="LblSpMaximum" Text="{DynamicResource PfX.033}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.034}" />
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtSpMaximum" />

                    <TextBlock Grid.Row="7" x:Name="LblSpTilt" Text="{DynamicResource PfX.035}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.036}" />
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtSpTilt" />

                    <TextBlock Grid.Row="8" x:Name="LblSpStopPin" Text="{DynamicResource PfX.037}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.038}" />
                    <CheckBox Grid.Row="8" Grid.Column="1" x:Name="ChkSpStopPin" Margin="0,2" Click="ChkSpStopPin_Click" />

                    <TextBlock Grid.Row="9" x:Name="LblSpNaturalFreq" Text="{DynamicResource PfX.039}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.040}" />
                    <TextBox Grid.Row="9" Grid.Column="1" x:Name="TxtSpNaturalFreq" />

                    <TextBlock Grid.Row="10" x:Name="LblSpDampingRatio" Text="{DynamicResource PfX.041}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.042}" />
                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtSpDampingRatio" />

                    <TextBlock Grid.Row="11" x:Name="LblSpStep" Text="{DynamicResource PfX.043}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.044}" />
                    <TextBox Grid.Row="11" Grid.Column="1" x:Name="TxtSpStep" />

                    <TextBlock Grid.Row="12" x:Name="LblSpInterval" Text="{DynamicResource PfX.045}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.046}" />
                    <TextBox Grid.Row="12" Grid.Column="1" x:Name="TxtSpInterval" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- 選んだセクションに書かれている「キー = 値」（計器では、上の欄にない項目だけ） -->
        <GroupBox x:Name="GrpSection" Header="{DynamicResource PfX.047}" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock x:Name="TxtSectionEmpty" Text="{DynamicResource PfX.048}" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ItemsControl x:Name="ListEntries">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PanelKey" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </GroupBox>

        <!-- [This] を選んだときの欄（表示領域とベース画像。このセクションは1つだけ書ける） -->
        <GroupBox x:Name="GrpThis" Header="{DynamicResource PfX.049}" Margin="0,0,0,6" Visibility="Collapsed">
            <StackPanel>
                <!-- バージョンで使えない項目・画像の大きさが 2 のべき乗でない、などのお知らせ（警告ではない） -->
                <TextBlock x:Name="TxtThisNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <!-- 数字でない・x, y の形でない・色が 6 桁でない、などの警告 -->
                <TextBlock x:Name="TxtThisWarnings" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource PfX.050}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.051}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtThisResolution" />

                    <TextBlock Grid.Row="1" Text="{DynamicResource PfX.052}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.053}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtThisLeft" />

                    <TextBlock Grid.Row="2" Text="{DynamicResource PfX.054}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.055}" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtThisTop" />

                    <TextBlock Grid.Row="3" Text="{DynamicResource PfX.056}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.057}" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtThisRight" />

                    <TextBlock Grid.Row="4" Text="{DynamicResource PfX.058}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.059}" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtThisBottom" />

                    <TextBlock Grid.Row="5" Text="{DynamicResource PfX.060}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.061}" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtThisDaytimeImage" />

                    <TextBlock Grid.Row="6" Text="{DynamicResource PfX.062}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.063}" />
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtThisNighttimeImage" />

                    <TextBlock Grid.Row="7" Text="{DynamicResource PfX.064}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.065}" />
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtThisTransparentColor" />

                    <TextBlock Grid.Row="8" Text="{DynamicResource PfX.066}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.067}" />
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtThisCenter" />

                    <TextBlock Grid.Row="9" Text="{DynamicResource PfX.068}" Style="{StaticResource FieldLabel}" ToolTip="{DynamicResource PfX.069}" />
                    <TextBox Grid.Row="9" Grid.Column="1" x:Name="TxtThisOrigin" />

                    <TextBlock Grid.Row="10" Text="{DynamicResource PfX.070}" Style="{StaticResource FieldLabel}"
                               ToolTip="{DynamicResource PfX.071}" />
                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtThisPerspective" />
                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
