<Window x:Class="BveVehicleEditor.TractionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="{DynamicResource TrX.001}" Width="820" Height="660" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">

    <!-- 力行の表（引張力・電流の空車と満車、無負荷電流。M 車 1 両あたり）を式から作るウィンドウ（電流・引張力テーブルの段階5）。計算は TractionCalculator.cs -->
    <Window.Resources>
        <!-- 名前と欄を縦に並べた 1 組（狭いときは横に折り返す） -->
        <Style x:Key="FieldPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,6" />
            <Setter Property="Width" Value="130" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,14,0">
                <!-- 作る表の種類と、その表の作り方（TractionWindow.xaml.cs の Explain で出す） -->
                <TextBlock x:Name="TxtKind" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2" />
                <TextBlock x:Name="TxtExplain" Style="{StaticResource Note}" Margin="0,0,0,6" />

                <GroupBox Header="{DynamicResource TrX.002}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{DynamicResource TrX.003}" />
                        <WrapPanel x:Name="PanelTargets" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource TrX.004}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="CmbPreview" MinWidth="160" SelectionChanged="CmbPreview_SelectionChanged" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource TrX.005}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Note}" Text="{DynamicResource TrX.006}" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.007}" /><TextBox x:Name="TxtMotorcarWeight" TextChanged="Input_TextChanged" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.008}" /><TextBox x:Name="TxtMotorcarCount" TextChanged="Input_TextChanged" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.009}" /><TextBox x:Name="TxtMotorcarInertia" TextChanged="Input_TextChanged" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.010}" /><TextBox x:Name="TxtTrailerWeight" TextChanged="Input_TextChanged" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.011}" /><TextBox x:Name="TxtTrailerCount" TextChanged="Input_TextChanged" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.012}" /><TextBox x:Name="TxtTrailerInertia" TextChanged="Input_TextChanged" /></StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource TrX.013}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{DynamicResource TrX.014}" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.015}" /><TextBox x:Name="TxtCapacity" TextChanged="Input_TextChanged" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.016}" /><TextBox x:Name="TxtBodyWeight" TextChanged="Input_TextChanged" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.017}" /><TextBox x:Name="TxtLoadPercent" TextChanged="Input_TextChanged" ToolTip="{DynamicResource TrX.018}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.019}" /><TextBox x:Name="TxtBoostUpTo" TextChanged="Input_TextChanged" ToolTip="{DynamicResource TrX.020}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.021}" /><TextBox x:Name="TxtForceRatio" IsReadOnly="True" ToolTip="{DynamicResource TrX.022}" /></StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource TrX.023}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{DynamicResource TrX.024}" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.025}" /><TextBox x:Name="TxtCurrentRatio" TextChanged="Input_TextChanged" ToolTip="{DynamicResource TrX.026}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.027}" /><TextBox x:Name="TxtNoLoadCurrent" TextChanged="Input_TextChanged" ToolTip="{DynamicResource TrX.028}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.029}" /><TextBox x:Name="TxtNoLoadDrop" TextChanged="Input_TextChanged" ToolTip="{DynamicResource TrX.030}" /></StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource TrX.031}" Margin="0,0,0,6">
                    <WrapPanel>
                        <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.032}" /><TextBox x:Name="TxtMaxSpeed" TextChanged="Input_TextChanged" ToolTip="{DynamicResource TrX.033}" /></StackPanel>
                        <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.034}" /><TextBox x:Name="TxtSpeedStep" TextChanged="Input_TextChanged" ToolTip="{DynamicResource TrX.035}" /></StackPanel>
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource TrX.036}" Margin="0,0,0,6">
                    <StackPanel>
                        <!-- 説明・欄の名前・表の列の見出しは、ブレーキのとき TractionWindow.xaml.cs の ApplyBrakeMode で変える -->
                        <TextBlock x:Name="TxtNotchNote" Style="{StaticResource Note}"
                                   Text="{DynamicResource TrX.037}" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock x:Name="LblTopAcceleration" Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.038}" /><TextBox x:Name="TxtTopAcceleration" /></StackPanel>
                            <StackPanel x:Name="PnlTopV1" Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.039}" /><TextBox x:Name="TxtTopV1" /></StackPanel>
                            <!-- ブレーキだけ：効き始める速度 vs と、最大になる速度 va -->
                            <StackPanel x:Name="PnlTopVs" Style="{StaticResource FieldPanel}" Visibility="Collapsed"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.040}" /><TextBox x:Name="TxtTopVs" ToolTip="{DynamicResource TrX.041}" /></StackPanel>
                            <StackPanel x:Name="PnlTopVa" Style="{StaticResource FieldPanel}" Visibility="Collapsed"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.042}" /><TextBox x:Name="TxtTopVa" ToolTip="{DynamicResource TrX.043}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock x:Name="LblTopV2" Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.044}" /><TextBox x:Name="TxtTopV2" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.045}" /><TextBox x:Name="TxtDecay" ToolTip="{DynamicResource TrX.046}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock x:Name="LblTopCurrent" Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.047}" /><TextBox x:Name="TxtTopCurrent" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource TrX.048}" /><TextBox x:Name="TxtNotchCount" ToolTip="{DynamicResource TrX.049}" /></StackPanel>
                            <Button Content="{DynamicResource TrX.050}" VerticalAlignment="Bottom" Margin="0,0,0,6" Click="BtnFillNotches_Click"
                                    ToolTip="{DynamicResource TrX.051}" />
                        </WrapPanel>
                        <DataGrid x:Name="GridNotches" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                                  MaxHeight="230" MinRowHeight="24" RowHeight="26" CellEditEnding="GridNotches_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource TrX.052}" Binding="{Binding Notch}" IsReadOnly="True" />
                                <DataGridTextColumn x:Name="ColAcceleration" Header="{DynamicResource TrX.053}" Binding="{Binding Acceleration, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn x:Name="ColV1" Header="v1 [km/h]" Binding="{Binding V1, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn x:Name="ColVs" Header="vs [km/h]" Binding="{Binding Vs, UpdateSourceTrigger=LostFocus}" Visibility="Collapsed" />
                                <DataGridTextColumn x:Name="ColVa" Header="va [km/h]" Binding="{Binding Va, UpdateSourceTrigger=LostFocus}" Visibility="Collapsed" />
                                <DataGridTextColumn x:Name="ColV2" Header="v2 [km/h]" Binding="{Binding V2, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn Header="{DynamicResource TrX.054}" Binding="{Binding Decay, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn x:Name="ColCurrent" Header="{DynamicResource TrX.055}" Binding="{Binding StartCurrentText, UpdateSourceTrigger=LostFocus}" />
                                <DataGridTextColumn x:Name="ColForce" Header="{DynamicResource TrX.056}" Binding="{Binding StartForce}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="LightGray" />

        <!-- プレビュー（表のウィンドウのグラフと同じ作り方。ChartBuilder） -->
        <oxy:PlotView x:Name="PlotPreview" Grid.Row="2" Background="Transparent" Margin="0,4,0,0" />

        <!-- 値の問題（問題があるうちは表に入れられない） -->
        <TextBlock x:Name="TxtProblems" Grid.Row="3" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnApply" Content="{DynamicResource TrX.057}" MinWidth="110" Margin="0,0,8,0" Click="BtnApply_Click"
                    Style="{DynamicResource AccentButtonStyle}" ToolTip="{DynamicResource TrX.058}" />
            <!-- Esc はノッチの表を直している途中の「やめる」に使うので、閉じるのはボタンだけ -->
            <Button Content="{DynamicResource TrX.059}" MinWidth="90" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</Window>
