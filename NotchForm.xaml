<UserControl x:Class="BveVehicleEditor.NotchForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ノッチのファイル（Notch.txt）の入力フォーム（電流・引張力テーブルの段階1：表のファイルの参照欄） -->
    <!-- [Power]・[Brake] の 6 つのファイルパスを出し、「参照」で選ぶと下のテキストを書き換える。行は NotchForm.xaml.cs で作る -->
    <StackPanel Grid.IsSharedSizeScope="True">
        <TextBlock Text="{DynamicResource NfX.001}"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="2,0,0,4" TextWrapping="Wrap" />

        <!-- ノッチのファイルを読み込めていない、などの知らせ -->
        <TextBlock x:Name="TxtNotchNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <!-- 見つからないファイル・使えないパスの警告 -->
        <TextBlock x:Name="TxtNotchWarnings" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />

        <GroupBox Header="{DynamicResource NfX.002}" Margin="0,0,0,6">
            <Grid x:Name="GridPower" />
        </GroupBox>
        <GroupBox Header="{DynamicResource NfX.003}" Margin="0,0,0,6">
            <Grid x:Name="GridBrake" />
        </GroupBox>
    </StackPanel>
</UserControl>
