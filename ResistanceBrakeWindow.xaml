<Window x:Class="BveVehicleEditor.ResistanceBrakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="{DynamicResource RbX.001}" Width="820" Height="660" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">

    <!-- 抵抗制御の発電ブレーキ（列が段ごと）の表（引張力・電流の空車と満車）を式から作るウィンドウ。計算は ResistanceCalculator.Brake.cs -->
    <Window.Resources>
        <Style x:Key="FieldPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,6" />
            <Setter Property="Width" Value="130" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,14,0">
                <TextBlock x:Name="TxtKind" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource Note}" Margin="0,0,0,6"
                           Text="{DynamicResource RbX.002}" />

                <GroupBox Header="{DynamicResource RbX.003}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{DynamicResource RbX.004}" />
                        <WrapPanel x:Name="PanelTargets" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource RbX.005}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="CmbPreview" MinWidth="160" SelectionChanged="CmbPreview_SelectionChanged" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource RbX.006}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock x:Name="TxtLayoutNote" Style="{StaticResource Note}" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.007}" /><TextBox x:Name="TxtSteps" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.008}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.009}" /><TextBox x:Name="TxtLimit" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.010}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.011}" /><TextBox x:Name="TxtRatedForce" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.012}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.013}" /><TextBox x:Name="TxtFirstSpeed" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.014}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.015}" /><TextBox x:Name="TxtLastSpeed" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.016}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.017}" /><TextBox x:Name="TxtSaturation" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.018}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.019}" /><TextBox x:Name="TxtSpeedDrop" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.020}" /></StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.021}" /><TextBox x:Name="TxtHighSaturation" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.022}" /></StackPanel>
                            <Button x:Name="BtnFit" Content="{DynamicResource RbX.023}" VerticalAlignment="Bottom" Margin="0,0,0,6" Click="BtnFit_Click" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.024}" />
                        <TextBox x:Name="TxtSwitchSpeeds" TextChanged="Input_TextChanged" Margin="0,0,0,6"
                                 ToolTip="{DynamicResource RbX.025}" />
                        <TextBlock x:Name="TxtFitResult" Style="{StaticResource Note}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource RbX.026}" Margin="0,0,0,6">
                    <WrapPanel>
                        <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.027}" /><TextBox x:Name="TxtMaxSpeed" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.028}" /></StackPanel>
                        <StackPanel Style="{StaticResource FieldPanel}"><TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource RbX.029}" /><TextBox x:Name="TxtSpeedStep" TextChanged="Input_TextChanged" ToolTip="{DynamicResource RbX.030}" /></StackPanel>
                    </WrapPanel>
                </GroupBox>

                <TextBlock x:Name="TxtSummary" Style="{StaticResource Note}" Margin="0,0,0,6" />
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="LightGray" />

        <oxy:PlotView x:Name="PlotPreview" Grid.Row="2" Background="Transparent" Margin="0,4,0,0" />

        <TextBlock x:Name="TxtProblems" Grid.Row="3" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnApply" Content="{DynamicResource RbX.031}" MinWidth="110" Margin="0,0,8,0" Click="BtnApply_Click"
                    Style="{DynamicResource AccentButtonStyle}" ToolTip="{DynamicResource RbX.032}" />
            <Button Content="{DynamicResource RbX.033}" MinWidth="90" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</Window>
