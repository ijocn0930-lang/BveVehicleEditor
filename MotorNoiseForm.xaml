<UserControl x:Class="BveVehicleEditor.MotorNoiseForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- モーター音のファイル（MotorNoise.txt）の入力フォーム（段階1：音量・ピッチの表のファイルの参照欄） -->
    <!-- [Power]・[Brake] の Volume・Frequency のファイルパスを出し、「参照」で選ぶと下のテキストを書き換える。行は MotorNoiseForm.xaml.cs で作る -->
    <StackPanel Grid.IsSharedSizeScope="True">
        <TextBlock Text="{DynamicResource MnX.001}"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="2,0,0,4" TextWrapping="Wrap" />

        <!-- モーター音のファイルを読み込めていない、などの知らせ -->
        <TextBlock x:Name="TxtMotorNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <!-- 見つからないファイル・使えないパスの警告 -->
        <TextBlock x:Name="TxtMotorWarnings" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,4"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />

        <GroupBox Header="{DynamicResource MnX.002}" Margin="0,0,0,6">
            <Grid x:Name="GridPower" />
        </GroupBox>
        <GroupBox Header="{DynamicResource MnX.003}" Margin="0,0,0,6">
            <Grid x:Name="GridBrake" />
        </GroupBox>
    </StackPanel>
</UserControl>
