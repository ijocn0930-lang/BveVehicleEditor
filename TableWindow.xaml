<Window x:Class="BveVehicleEditor.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="{DynamicResource TwX.001}" Width="800" Height="600" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown">

    <!-- 表のファイル（引張力・電流・進段パラメーターなどの CSV）を表の形で見る・直す・保存するウィンドウ（電流・引張力テーブルの段階2a・2b） -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <!-- ファイルの場所（長ければ「…」で省略。吹き出しで全部見せる） -->
            <TextBlock x:Name="TxtFilePath" TextTrimming="CharacterEllipsis" />
            <!-- ヘッダーと文字コード -->
            <TextBlock x:Name="TxtFileInfo" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <!-- ヘッダーの文字コード指定が合わない、数字でないセルがある、などの警告 -->
            <TextBlock x:Name="TxtTableWarnings" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <!-- 書かれていない項目、ヘッダーのバージョンより新しい項目、などのお知らせ（進段パラメーターだけ） -->
            <TextBlock x:Name="TxtTableNotices" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{DynamicResource TwX.002}"
                       TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- 「表」と「グラフ」のタブ（グラフは TableWindow.Graph.cs。進段パラメーターはグラフのタブを隠す） -->
        <TabControl x:Name="TabsTable" Grid.Row="1" SelectionChanged="TabsTable_SelectionChanged">
            <TabItem Header="{DynamicResource TwX.003}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

        <!-- 行・列を足す・消す（選んでいるセルの行・列が対象。狭いときは折り返す） -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <Button Content="{DynamicResource TwX.004}" Margin="0,0,6,4" Click="BtnAddRow_Click"
                    ToolTip="{DynamicResource TwX.005}" />
            <Button Content="{DynamicResource TwX.006}" Margin="0,0,12,4" Click="BtnRemoveRow_Click"
                    ToolTip="{DynamicResource TwX.007}" />
            <Button x:Name="BtnAddColumn" Content="{DynamicResource TwX.008}" Margin="0,0,6,4" Click="BtnAddColumn_Click"
                    ToolTip="{DynamicResource TwX.009}" />
            <Button Content="{DynamicResource TwX.010}" Margin="0,0,12,4" Click="BtnRemoveColumn_Click"
                    ToolTip="{DynamicResource TwX.011}" />
            <!-- 進段パラメーターで、書かれていない項目があるときだけ出す -->
            <Button x:Name="BtnAddMissing" Content="{DynamicResource TwX.012}" Margin="0,0,12,4" Visibility="Collapsed" Click="BtnAddMissing_Click"
                    ToolTip="{DynamicResource TwX.013}" />
            <!-- 力行の引張力（空車）のときだけ出す（TractionWindow） -->
            <Button x:Name="BtnGenerate" Content="{DynamicResource TwX.014}" Margin="0,0,6,4" Visibility="Collapsed" Click="BtnGenerate_Click"
                    ToolTip="{DynamicResource TwX.015}" />
            <!-- 力行の引張力・電流（空車・満車）のときだけ出す（ResistanceWindow。列が進段ごとの抵抗制御の車両向け） -->
            <Button x:Name="BtnResistance" Content="{DynamicResource TwX.016}" Margin="0,0,0,4" Visibility="Collapsed" Click="BtnResistance_Click"
                    ToolTip="{DynamicResource TwX.017}" />
        </WrapPanel>

        <!-- 表。列はコード（TableWindow.xaml.cs の BuildColumns）で作る。左の「行」と 1 列目は横に動かしても見えるままにする -->
        <DataGrid x:Name="GridTable" Grid.Row="1"
                  AutoGenerateColumns="False" CellEditEnding="GridTable_CellEditEnding" BeginningEdit="GridTable_BeginningEdit"
                  PreviewKeyDown="GridTable_PreviewKeyDown" MouseDoubleClick="GridTable_MouseDoubleClick"
                  PreviewMouseRightButtonDown="GridTable_PreviewMouseRightButtonDown" ContextMenuOpening="GridTable_ContextMenuOpening"
                  CanUserSortColumns="False" CanUserReorderColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" FrozenColumnCount="2"
                  SelectionUnit="Cell" GridLinesVisibility="All"
                  EnableColumnVirtualization="True" EnableRowVirtualization="True"
                  MinRowHeight="24" RowHeight="26">
            <DataGrid.Resources>
                <!-- セルの文字（列を作るときに ElementStyle に入れる）。コメントの行は灰色の文字 -->
                <!-- 行（DataGridRow）の見た目を変えるとダークテーマの背景が白くなるので、セルの文字だけを変える -->
                <Style x:Key="CellTextStyle" TargetType="TextBlock">
                    <Setter Property="Margin" Value="6,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsComment}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <!-- 右クリックメニュー（処理は TableWindow.Editing.cs。選んでいるセルの行・列が対象） -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <!-- 元に戻す・やり直す（TableWindow.Undo.cs。押せるかはメニューを開くときに決める） -->
                    <MenuItem x:Name="MenuUndo" Header="{DynamicResource TwX.018}" InputGestureText="Ctrl+Z" Click="MenuUndo_Click" />
                    <MenuItem x:Name="MenuRedo" Header="{DynamicResource TwX.019}" InputGestureText="Ctrl+Y" Click="MenuRedo_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource TwX.020}" Click="MenuAddRowAbove_Click" />
                    <MenuItem Header="{DynamicResource TwX.021}" Click="MenuAddRowBelow_Click" />
                    <MenuItem Header="{DynamicResource TwX.022}" Click="BtnRemoveRow_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource TwX.023}" Click="MenuAddColumnLeft_Click" />
                    <MenuItem Header="{DynamicResource TwX.024}" Click="MenuAddColumnRight_Click" />
                    <MenuItem Header="{DynamicResource TwX.025}" Click="MenuRemoveColumns_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource TwX.026}" InputGestureText="Delete" Click="MenuClearCells_Click" />
                    <Separator />
                    <MenuItem Header="{DynamicResource TwX.027}" InputGestureText="Ctrl+X" Command="ApplicationCommands.Cut" />
                    <MenuItem Header="{DynamicResource TwX.028}" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy" />
                    <MenuItem Header="{DynamicResource TwX.029}" InputGestureText="Ctrl+V" Command="ApplicationCommands.Paste" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
                </Grid>
            </TabItem>

            <!-- グラフ：横が速度、縦が引張力・電流。ノッチごとの線。マウスを乗せると近い点の値を出す -->
            <TabItem x:Name="TabGraph" Header="{DynamicResource TwX.030}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource TwX.031}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <oxy:PlotView x:Name="PlotGraph" Grid.Row="1" Background="Transparent" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <!-- 直したところがあるときだけ押せる -->
            <Button x:Name="BtnSave" Content="{DynamicResource TwX.032}" MinWidth="90" IsEnabled="False" Click="BtnSave_Click" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" ToolTip="{DynamicResource TwX.033}" />
            <Button Content="{DynamicResource TwX.034}" MinWidth="90" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</Window>
