<Window x:Class="BveVehicleEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AbX.001}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- 「ヘルプ → バージョン情報…」のウィンドウ。アプリの名前・バージョン・開発者（GitHub のプロフィールへのリンク）と、使っている部品の版 -->
    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="TxtAppName" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="TxtVersion" Margin="0,2,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock TextWrapping="Wrap">
            <Run Text="{DynamicResource AbX.002}" />
            <Run x:Name="RunDeveloper" />
        </TextBlock>
        <TextBlock Margin="0,2,0,12" TextWrapping="Wrap">
            <Run Text="GitHub：" />
            <Hyperlink x:Name="LinkGitHub" RequestNavigate="Link_RequestNavigate" ToolTip="{DynamicResource AbX.003}">
                <Run x:Name="RunGitHub" />
            </Hyperlink>
        </TextBlock>

        <TextBlock Text="{DynamicResource AbX.004}" FontWeight="SemiBold" Margin="0,0,0,2" />
        <TextBlock x:Name="TxtComponents" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />

        <!-- ライセンスと免責事項（LicenseWindow）を開くボタンと、閉じるボタン -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Lic.006}" ToolTip="{DynamicResource Lic.007}" Margin="0,0,8,0" Click="BtnLicense_Click" />
            <Button Content="{DynamicResource AbX.005}" MinWidth="90" IsDefault="True" IsCancel="True" Click="BtnClose_Click" />
        </StackPanel>
    </StackPanel>
</Window>
